erDiagram

"space" }o--o| "space_deletion" : "deletion_id"
"folder" }o--|| "space" : "space_id"
"folder" }o--|| "folder" : "parent_id, space_id"
"document" }o--|| "space" : "space_id"
"document" }o--|| "folder" : "folder_id, space_id"

"space" {
  uuid id
  space_kind kind
  text name
  text personal_owner
  timestamp_with_time_zone created_at
  uuid deletion_id FK
}
"folder" {
  uuid id
  uuid space_id FK
  uuid parent_id FK
  text name
  text path
  timestamp_with_time_zone created_at
}
"document" {
  uuid id
  uuid space_id FK
  uuid folder_id FK
  text name
  text mime
  bigint size
  text sha256
  text created_by
  timestamp_with_time_zone created_at
}
"platform_bootstrap" {
  boolean singleton
  text completed_by
  timestamp_with_time_zone completed_at
  timestamp_with_time_zone granted_at
}
"authorization_store" {
  boolean singleton
  text configured_store
  text source_store
  text active_store
  text model_id
}
"terms_acceptance" {
  text user_id
  text version
  timestamp_with_time_zone accepted_at
}
"space_deletion" {
  uuid id
  uuid target_id
  space_kind target_kind
  uuid target_parent_id
  uuid organization_id
  text actor_subject
  timestamp_with_time_zone requested_at
  timestamp_with_time_zone due_at
  text mode
  text rule_id
  text status
  timestamp_with_time_zone last_visit
  timestamp_with_time_zone completed_at
  text error_code
  bigint folders_deleted
  bigint spaces_deleted
}
