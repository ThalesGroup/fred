{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug fred-agents",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/apps/fred-agents/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/fred-agents",
      "module": "fred_agents",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/fred-agents",
        "ENV_FILE": "${workspaceFolder}/apps/fred-agents/config/.env"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug fred-agents-worker",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/apps/fred-agents/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/fred-agents",
      "module": "fred_agents",
      "args": [
        "--mode",
        "worker"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/fred-agents",
        "ENV_FILE": "${workspaceFolder}/apps/fred-agents/config/.env"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug knowledge-flow-backend",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/apps/knowledge-flow-backend/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/knowledge-flow-backend",
      "module": "uvicorn",
      "args": [
        "knowledge_flow_backend.main:create_app",
        "--factory",
        "--host",
        "0.0.0.0",
        "--port",
        "8111",
        "--loop",
        "asyncio"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/knowledge-flow-backend",
        "ENV_FILE": "${workspaceFolder}/apps/knowledge-flow-backend/config/.env"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug knowledge-flow-worker",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/apps/knowledge-flow-worker/.venv/bin/python",
      "cwd": "${workspaceFolder}/apps/knowledge-flow-worker",
      "program": "${workspaceFolder}/apps/knowledge-flow-worker/knowledge_flow_worker/main.py",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/knowledge-flow-worker",
        "ENV_FILE": "${workspaceFolder}/apps/knowledge-flow-worker/config/.env"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "make run",
      "cwd": "${workspaceFolder}/apps/frontend"
    },
    {
      "name": "Debug all Knowledge Flow Backend tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/knowledge-flow-backend",
      "args": [
        "-s",
        "-q"
      ],
      "envFile": "config/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/knowledge-flow-backend/knowledge_flow_backend",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "LOG_LEVEL": "DEBUG"
      },
      "justMyCode": false
    },
    {
      "name": "Debug all Fred Agents tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/fred-agents",
      "args": [
        "-s",
        "-q"
      ],
      "envFile": "config/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/fred-agents/fred_agents",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "LOG_LEVEL": "DEBUG"
      },
      "justMyCode": false
    },
    {
      "name": "Debug one Knowledge Flow Backend test",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/knowledge-flow-backend",
      "args": [
        "-s",
        "-vv",
        "knowledge_flow_backend/tests/services/test_output_processor_service.py::TestOutputProcessorService::test_process_real_pdf_success"
      ],
      "justMyCode": false,
      "envFile": "config/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/knowledge-flow-backend/knowledge_flow_backend",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "LOG_LEVEL": "DEBUG"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug current Knowledge Flow Backend test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/knowledge-flow-backend",
      "args": [
        "-s",
        "-vv",
        "${file}"
      ],
      "envFile": "config/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/knowledge-flow-backend/knowledge_flow_backend",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "LOG_LEVEL": "DEBUG"
      },
      "justMyCode": false
    },
    {
      "name": "Debug current Fred Agents test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/apps/fred-agents",
      "args": [
        "-s",
        "-vv",
        "${file}"
      ],
      "envFile": "config/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/fred-agents/fred_agents",
        "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
        "LOG_LEVEL": "DEBUG"
      },
      "justMyCode": false
    }
  ]
}
