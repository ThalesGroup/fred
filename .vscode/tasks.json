  "tasks": [
    {
      "label": "Fred — kill all",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "-c",
        "import os\nimport signal\nimport subprocess\nimport time\nfrom pathlib import Path\n\nroot = Path.cwd().resolve()\nports = (8000, 8111, 8222, 5173, 9000, 9111, 9112, 9222, 8010, 8013, 8020, 8336)\n\ndef listeners():\n    result = set()\n    for port in ports:\n        found = subprocess.run(['lsof', '-t', '-iTCP:' + str(port), '-sTCP:LISTEN'], capture_output=True, text=True)\n        result.update(int(pid) for pid in found.stdout.split())\n    return result\n\ndef identity(pid):\n    proc = Path('/proc') / str(pid)\n    try:\n        cwd = (proc / 'cwd').resolve(strict=True)\n        command = (proc / 'cmdline').read_bytes().replace(bytes([0]), b' ').decode(errors='replace')\n        stamp = (proc / 'stat').read_text().rsplit(')', 1)[1].split()[19]\n        return cwd, command, stamp\n    except (OSError, IndexError):\n        return None\n\npids = listeners()\n# Include reload supervisors and workers even when they have no listener.\nfor proc in Path('/proc').iterdir():\n    if not proc.name.isdigit():\n        continue\n    info = identity(int(proc.name))\n    if int(proc.name) == os.getpid():\n        continue\n    if info and Path(info[1].split()[0]).name in ('uvicorn', 'uv', 'python', 'python3', 'python3.12') and any(name in info[1] for name in ('uvicorn', 'control_plane_backend.main_worker', 'knowledge_flow_backend/main_worker.py', 'knowledge_flow_backend.main_worker')) and info[0].is_relative_to(root):\n        pids.add(int(proc.name))\n# Stop make/uv parents too: leaving a supervisor can respawn its child.\nfor pid in tuple(pids):\n    parent = pid\n    while True:\n        try:\n            parent = int((Path('/proc') / str(parent) / 'stat').read_text().rsplit(')', 1)[1].split()[1])\n            info = identity(parent)\n            if not info or not info[0].is_relative_to(root):\n                break\n            executable = Path(info[1].split()[0]).name\n            if executable not in ('make', 'uv', 'uvicorn', 'python', 'python3'):\n                break\n            pids.add(parent)\n        except (OSError, IndexError, ValueError):\n            break\ntargets = {}\npending = {}\nfor pid in sorted(pids):\n    info = identity(pid)\n    if not info:\n        continue\n    if not info[0].is_relative_to(root):\n        print(f'Preserved PID {pid}: process outside this checkout ({info[0]}).')\n        continue\n    print(f'Stopping PID {pid}: {info[1]}')\n    targets[pid] = info[2]\n    try:\n        os.kill(pid, signal.SIGTERM)\n    except ProcessLookupError:\n        pass\nfor attempt in range(30):\n    pending = {pid: stamp for pid, stamp in targets.items() if (info := identity(pid)) and info[2] == stamp}\n    if not pending:\n        break\n    time.sleep(.2)\nfor pid, stamp in pending.items():\n    info = identity(pid)\n    if info and info[2] == stamp:\n        print(f'Forcing shutdown of PID {pid}.')\n        try:\n            os.kill(pid, signal.SIGKILL)\n        except ProcessLookupError:\n            pass\ntime.sleep(.3)\nremaining = listeners()\nif remaining:\n    raise SystemExit('Ports still occupied by PIDs: ' + ', '.join(map(str, sorted(remaining))) + '. See preserved processes above.')\nprint('Fred application ports released. Docker infrastructure unchanged.')\n"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "icon": {
        "id": "debug-stop",
        "color": "terminal.ansiRed"
      }
    },
