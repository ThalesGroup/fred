# The checkout owns its topology; the factory owns infrastructure and browser URLs.
{{- if or (ne (env "KUBE_CONTEXT") "k3d-fred") (ne (env "K3D_NAMESPACE") "fred-weaver") }}
{{- fail "Run make k3d-up or make k3d-up-weaver from fred-deployment-factory" }}
{{- end }}
releases:
  - name: fred-app
    chart: ../charts/fred
    values:
      - base-values.yaml.gotmpl
      - browser-values.yaml.gotmpl
      - values.yaml.gotmpl
      - instance-values.yaml.gotmpl
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
      {{- $generated := printf "%s/manager-ingestion.generated.yaml" (requiredEnv "K3D_APP_OUT") }}
      {{- if isFile $generated }}
      - {{ $generated | quote }}
      {{- end }}
