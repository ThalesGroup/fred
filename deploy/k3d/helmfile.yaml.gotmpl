# Fred on the local k3d instance of fred-deployment-factory, which runs
#   make k3d-app DIR=<this checkout> [RELEASE=<version>]
# and passes the kube context and the namespace. deploy/k3d/build writes the
# images' values (K3D_IMAGE_VALUES); without it the chart's default images run.
# RELEASE deploys that published chart and its images instead of this
# checkout's; the k3d values below stay this checkout's.
{{- $release := env "RELEASE" }}
releases:
  - name: fred-app
    {{- if $release }}
    chart: oci://ghcr.io/thalesgroup/fred-helm/fred
    version: {{ $release | quote }}
    {{- else }}
    chart: ../charts/fred
    {{- end }}
    values:
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
      {{- if env "WEB_RESEARCH_PROVIDER_KEY" }}
      # Brave web research, keyed from fred-secrets (written by deploy/k3d/prepare).
      - applications:
          fred-agents:
            configuration:
              web_research:
                enabled: true
      {{- end }}
