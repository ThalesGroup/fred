# Fred on the local k3d instance of fred-deployment-factory, which runs
#   make k3d-app DIR=<this checkout>
# and passes the kube context and the namespace. deploy/k3d/build writes the
# images' values (K3D_IMAGE_VALUES); without it the chart's default images run.
releases:
  - name: fred-app
    chart: ../charts/fred
    values:
      - values.yaml
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
      {{- if env "WEB_RESEARCH_PROVIDER_KEY" }}
      # Brave web research, keyed from fred-secrets (written by deploy/k3d/prepare).
      - applications:
          fred-agents:
            configuration:
              web_research:
                enabled: true
      {{- end }}
