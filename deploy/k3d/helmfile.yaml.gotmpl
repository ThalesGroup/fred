# The checkout owns its topology; the factory owns infrastructure and browser URLs.
{{- if and (ne (env "ENV") "secondary") (ne (env "INSTANCE") "weaver") }}
{{- fail "Use INSTANCE=weaver for coexistence, or ENV=secondary for the standalone cluster" }}
{{- end }}
releases:
  - name: fred-app
    chart: ../charts/fred
    values:
      - base-values.yaml.gotmpl
      - secondary-values.yaml.gotmpl
      - values.yaml.gotmpl
      - instance-values.yaml.gotmpl
      {{- with env "K3D_IMAGE_VALUES" }}
      - {{ . | quote }}
      {{- end }}
      {{- $generated := printf "%s/manager-ingestion.generated.yaml" (requiredEnv "K3D_APP_OUT") }}
      {{- if isFile $generated }}
      - {{ $generated | quote }}
      {{- end }}
