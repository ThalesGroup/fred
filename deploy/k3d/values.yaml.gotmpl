# Rust ingestion and Python agent catalog overlay owned by this checkout.
# make k3d-app ENV=secondary APP=fred DIR=../fred
# prepare exports the selected worker's contract and provisions application identities.

# secret: lists replace the instance lists, so retain every required dependency.
x-postgres: &postgres
  name: FRED_POSTGRES_PASSWORD
  valueFrom: {secretKeyRef: {name: fred-secrets, key: POSTGRES_FRED_PASSWORD}}
x-model: &model
  name: OPENAI_API_KEY
  valueFrom: {secretKeyRef: {name: fred-model-credentials, key: OPENAI_API_KEY}}
applications:
  frontend:
    # posture: use baked branding, without infrastructure credentials in the gateway.
    extraEnvVars:
      - name: FRONTEND_CONTROL_PLANE_UPSTREAM
        value: http://control-plane-backend.{{ requiredEnv "K3D_NAMESPACE" }}.svc.cluster.local:8222
    ingress:
      hosts:
        - host: ""
          paths:
            - {path: /, pathType: Prefix, service: {name: frontend, port: 80}}
            - {path: /control-plane, pathType: Prefix, service: {name: control-plane-backend, port: 8222}}
            - {path: /fred/agents/v2, pathType: Prefix, service: {name: fred-agents, port: 80}}

  fred-agents:
    # Deploy the real Python runtime; organization template activation stays in the UI.
    enabled: true
    migration:
      enabled: true
      extraEnvVars: [*postgres]
    configuration:
      # Execution still runs in the pod; match the control-plane source exactly.
      inference_credentials:
        - source_id: mistral
          api_root: https://api.mistral.ai/v1
          credential_binding: mistral
          api_key_env: OPENAI_API_KEY
      app:
        gcu_version: v1
      security:
        profile: c3
  control-plane-backend:
    lifecycle_policy_catalog:
      space_policies:
        purge:
          default:
            retention: PT1M
    # Keep the standard chart resource name; the executable is control-plane.
    applicationName: control-plane-backend
    command: {enabled: true, data: [control-plane, serve]}
    serviceAccount:
      name: control-plane-backend
    ingress:
      enabled: false
    volumes:
      - name: manager-catalog
        configMap: {name: control-plane-backend-catalog}
      - name: manager-config
        configMap: {name: control-plane-backend-back}
      - name: manager-env
        secret: {secretName: control-plane-backend-env}
    volumeMounts:
      - {name: manager-catalog, mountPath: /app/config/lifecycle_policy_catalog.yaml, subPath: lifecycle_policy_catalog.yaml}
      - {name: manager-config, mountPath: /app/config/configuration.yaml, subPath: configuration.yaml}
      - {name: manager-env, mountPath: /app/config/.env, subPath: .env}
    extraEnvVars:
      - *postgres
      - *model
      - name: SSL_CERT_FILE
        value: /etc/fred/node-ca/ca-certificates.crt
      - name: KEYCLOAK_CONTROL_PLANE_CLIENT_SECRET
        valueFrom: {secretKeyRef: {name: fred-secrets, key: KEYCLOAK_CONTROL_PLANE_CLIENT_SECRET}}
      - name: FRED_BOOTSTRAP_TOKEN
        valueFrom: {secretKeyRef: {name: fred-secrets, key: CONTROL_PLANE_BOOTSTRAP_TOKEN}}
      - name: FRED_CONTENT_ACCESS_KEY
        value: fred-document-manager
      - name: FRED_CONTENT_SECRET_KEY
        valueFrom: {secretKeyRef: {name: fred-ingestion, key: manager-s3-secret}}
    extraVolumes:
      - name: node-ca
        hostPath: {path: /etc/ssl/certs/ca-certificates.crt, type: File}
      - name: processing-contract
        configMap: {name: manager-processing-contract}
    extraVolumeMounts:
      - name: node-ca
        mountPath: /etc/fred/node-ca/ca-certificates.crt
        readOnly: true
      - name: processing-contract
        mountPath: /app/processing-contract
        readOnly: true
    resources:
      requests: {cpu: "250m", memory: 256Mi, ephemeral-storage: 1Gi}
      limits: {cpu: "2", memory: 1Gi, ephemeral-storage: 2Gi}
    configuration:
      # The chart defaults plus these k3d addresses; the factory supplies none of it.
      platform:
        # Local test source, replacing Swift's Small/Medium static profiles.
        # Discovery lists all offers; authorize mistral-small-latest and
        # mistral-medium-latest for the organization in the Models tab.
        model_sources:
          - source_id: mistral
            revision: 1
            enabled: true
            discovery_url: https://api.mistral.ai/v1/models
            inference:
              provider: openai
              api_root: https://api.mistral.ai/v1
              credential_binding: mistral
            visibility_scope: local-test-mistral-account
            authentication:
              mode: bearer
              secret_env_var: OPENAI_API_KEY
              # API operations of the existing local test key, not OAuth scope names.
              provider_scopes: ["GET /v1/models", "POST /v1/chat/completions"]
              authority: discovery_and_inference
              # Explicit reuse of the existing Swift test key for discovery.
              accept_inference_authority: true
            qualification: mixed_capabilities_v1
            complete_inventory_guaranteed: true
        runtime_catalog_sources:
          - runtime_id: fred-agents
            base_url: http://fred-agents/fred/agents/v2
            public_base_url: /fred/agents/v2
            enabled: true
      security:
        m2m: {realm_url: {{ requiredEnv "K3D_REALM_URL" | quote }}}
        user: {realm_url: {{ requiredEnv "K3D_REALM_URL" | quote }}}
        authorized_origins: [{{ requiredEnv "K3D_PUBLIC_URL" | quote }}]
        # Match the pod's inherited outgoing delegation and Swift's trust policy.
        delegation:
          accept_delegated_calls: true
          service_accounts_only: true
      storage:
        content:
          # address/choice: the Swift documents bucket and input/output roots.
          endpoint: http://seaweedfs:8333
          bucket: app-content-documents
          prefix: ""
          allow_insecure: true
          limits:
            file_bytes: 104857600
            uploads: 4
            downloads: 8
            temp_bytes: 419430400
            s3_seconds: 120
            transfer_seconds: 300
      scheduler:
        lifecycle:
          enabled: true
          temporal: {host: "temporal:7233"}
        processing:
          enabled: true
          worker_contract_file: /app/processing-contract/worker-contract.json
          temporal: {host: "temporal:7233", namespace: default, task_queue: manager-ingestion}
          worker:
            issuer: {{ requiredEnv "K3D_REALM_URL" | quote }}
            audience: control-plane
            client_id: knowledge-flow-worker
          derived:
            endpoint: http://seaweedfs:8333
            bucket: app-content-documents
            prefix: ""
            allow_insecure: true
            access_key_env_var: FRED_CONTENT_ACCESS_KEY
            secret_key_env_var: FRED_CONTENT_SECRET_KEY
          limits:
            pending: 100
            output_bytes: 536870912
            artifacts: 2000
            chunks: 100000

  control-plane-worker:
    enabled: false

  knowledge-flow-backend:
    # The capability backend: agent pods call it for a person, in an admitted turn.
    # Control Plane authorizes the corpus; local SQL checks its publication state.
    migration: {enabled: false}
    configuration:
      control_plane_url: http://control-plane-backend:8222/control-plane/v1
      published_artifacts:
        endpoint: http://seaweedfs:8333
        bucket: app-content-documents
        access_key_env: KF_ARTIFACT_ACCESS_KEY
        secret_key_env: KF_ARTIFACT_SECRET_KEY
        allow_insecure: true
      security:
        m2m:
          enabled: true
        delegation:
          accept_delegated_calls: true
          act_for_people: true
      storage:
        opensearch:
          username: fred-kf-api
        vector_store:
          type: opensearch
          # Must equal the worker's manager_processing.vector_store.index.
          index: document-vectors

  knowledge-flow-worker:
    # This worker uses its dedicated processing identity.
    extraEnvVars:
      - *model
      - name: COLUMNS
        value: "250"
      # Retain the node CA trust configured by the shared KF values.
      - name: SSL_CERT_FILE
        value: /etc/fred/node-ca/ca-certificates.crt
      - name: OPENSEARCH_PASSWORD
        valueFrom: {secretKeyRef: {name: fred-ingestion, key: opensearch-password}}
      - name: MANAGER_WORKER_CLIENT_SECRET
        valueFrom: {secretKeyRef: {name: fred-secrets, key: KEYCLOAK_MANAGER_WORKER_CLIENT_SECRET}}
      - name: MANAGER_DERIVED_ACCESS_KEY
        value: fred-document-processor
      - name: MANAGER_DERIVED_SECRET_KEY
        valueFrom: {secretKeyRef: {name: fred-ingestion, key: processor-s3-secret}}
    volumes:
      - name: knowledge-flow-worker-vol
        configMap: {name: knowledge-flow-worker-back}
      - name: knowledge-flow-worker-env-vol
        secret: {secretName: knowledge-flow-worker-env}
    resources:
      # sizing: four roles x one activity x 1 GiB workspace, plus process overhead.
      requests: {cpu: "1", memory: 2Gi, ephemeral-storage: 5Gi}
      limits: {cpu: "4", memory: 6Gi, ephemeral-storage: 8Gi}
    configuration:
      app:
        pdf_render_ttl_days: 0
      observability:
        kpi:
          opensearch: {enabled: true, index: kpi-index}
      # Required by the shared configuration model, unused by manager activities.
      # Remote originals and outputs use manager_processing below.
      content_storage: {type: local, root_path: /tmp/manager-processing}
      filesystem: {type: local, root: /tmp/manager-processing}
      storage:
        opensearch:
          username: fred-kf-ingestion
      scheduler:
        enabled: true
        backend: temporal
        temporal:
          host: temporal:7233
          namespace: default
          task_queue: manager-ingestion
          ingestion_max_concurrent_activities: 1
      manager_processing:
        enabled: true
        url: http://control-plane-backend:8222/control-plane/v1
        issuer: {{ requiredEnv "K3D_REALM_URL" | quote }}
        audience: control-plane
        client_id: knowledge-flow-worker
        endpoint: http://seaweedfs:8333
        bucket: app-content-documents
        allow_insecure: true
        temporary_bytes: 1073741824
        vector_store:
          type: opensearch
          # choice: Swift mapping; isolated until readers enforce manager publication/ReBAC.
          index: document-vectors
          bulk_size: 1000
