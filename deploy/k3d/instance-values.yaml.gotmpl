{{- /* Application placement is independent of the infrastructure environment. */ -}}
{{- $database := env "K3D_DATABASE" | default "fred" -}}
{{- $temporal := env "K3D_TEMPORAL_NAMESPACE" | default "default" -}}
postgresBootstrap:
  database: {{ $database | quote }}
applications:
  frontend:
    ingress:
      hosts:
        - host: {{ requiredEnv "K3D_APP_HOST" | quote }}
          paths:
            - {path: /, pathType: Prefix, service: {name: frontend, port: 80}}
            - {path: /control-plane, pathType: Prefix, service: {name: control-plane-backend, port: 8222}}
            - {path: /fred/agents/v2, pathType: Prefix, service: {name: fred-agents, port: 80}}
  control-plane-backend:
    configuration:
      storage:
        postgres:
          database: {{ $database | quote }}
      scheduler:
        lifecycle:
          temporal:
            namespace: {{ $temporal | quote }}
        processing:
          temporal:
            namespace: {{ $temporal | quote }}
  fred-agents:
    configuration:
      storage:
        postgres:
          database: {{ $database | quote }}
      scheduler:
        temporal:
          namespace: {{ $temporal | quote }}
  knowledge-flow-backend:
    configuration:
      storage:
        postgres:
          database: {{ $database | quote }}
  knowledge-flow-worker:
    configuration:
      storage:
        postgres:
          database: {{ $database | quote }}
      scheduler:
        temporal:
          namespace: {{ $temporal | quote }}
