{{- /* The factory's secondary URLs and frontend settings, rendered here so that its
control-plane configuration can be dropped: values.yaml.gotmpl owns that configuration. */ -}}
{{- $text := readFile (printf "%s/k3d-apps/fred/secondary.yaml.gotmpl" (requiredEnv "K3D_FACTORY_ROOT")) -}}
{{- $secondary := tpl $text . | fromYaml -}}
{{- range $name := list "control-plane-backend" "control-plane-worker" -}}
  {{- with index $secondary.applications $name -}}
    {{- $_ := unset . "configuration" -}}
  {{- end -}}
{{- end -}}
{{- /* The checkout's permission authority is Control Plane/PostgreSQL. */ -}}
{{- range $app := $secondary.applications -}}
  {{- with (index $app "configuration") -}}
    {{- with (index . "security") -}}{{- $_ := unset . "rebac" -}}{{- end -}}
  {{- end -}}
  {{- $env := list -}}
  {{- range (index $app "extraEnvVars" | default (list)) -}}
    {{- if ne .name "OPENFGA_API_TOKEN" -}}{{- $env = append $env . -}}{{- end -}}
  {{- end -}}
  {{- if hasKey $app "extraEnvVars" -}}{{- $_ := set $app "extraEnvVars" $env -}}{{- end -}}
{{- end -}}
{{ $secondary | toYaml }}
