{{- /* The factory's browser URLs and frontend settings, rendered here so that its
control-plane configuration can be dropped: values.yaml.gotmpl owns that configuration. */ -}}
{{- $text := readFile (printf "%s/k3d-apps/fred/browser-values.yaml.gotmpl" (requiredEnv "K3D_FACTORY_ROOT")) -}}
{{- $browser := tpl $text . | fromYaml -}}
{{- range $name := list "control-plane-backend" "control-plane-worker" -}}
  {{- with index $browser.applications $name -}}
    {{- $_ := unset . "configuration" -}}
  {{- end -}}
{{- end -}}
{{ $browser | toYaml }}
