    {
      "id": 7,
      "title": "Recovered proposals per 100 model calls \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "Count per 100 model requests, not a percentage: one response may contain several calls.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
