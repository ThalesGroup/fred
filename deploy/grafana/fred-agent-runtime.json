      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(agent_tool_latency_ms_count{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tool failures \u00b7 last 24h",
      "type": "stat",
      "description": "No data is normal until the first failure series exists.",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
