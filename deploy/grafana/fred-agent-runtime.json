          "refId": "A",
          "editorMode": "code",
          "expr": "100 * max(rate(process_cpu_seconds_total[$__rate_interval]) and on(job, instance) llm_calls_total{service=~\"${service:regex}\"})",
          "legendFormat": "worst process",
          "range": true
        }
      ],
      "description": "Native Prometheus process collector, joined to the selected Fred targets by scrape job/instance. 100% is one CPU core."
    },
    {
      "id": 20,
      "title": "Resident memory \u00b7 all selected processes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
