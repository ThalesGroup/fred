  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "fred",
    "agents",
    "runtime",
    "tool-recovery"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Fred service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(llm_call_latency_ms_count, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fred agent runtime",
  "uid": "fred-agent-runtime",
  "version": 1
}
