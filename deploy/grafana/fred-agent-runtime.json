      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (model_name) (increase(agent_tool_call_text_recovered_total{namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",service=~\"${service:regex}\"}[24h])) / clamp_min(sum by (model_name) (increase(llm_call_latency_ms_count{namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",service=~\"${service:regex}\"}[24h])), 1e-9)",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
