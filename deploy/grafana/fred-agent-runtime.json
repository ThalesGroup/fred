{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Fred runtime metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Operational health of Fred agent model calls, tool calls, and Mistral tool-call recovery.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read recovery",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Recovered calls are valid tool-call proposals reconstructed from completed Mistral responses. Later approval, budget, or execution checks can still stop a proposal. The counter is emitted once per reconstructed call, grouped by model; no user, session, or tool arguments are exported as labels. A blank recovery panel means no matching series has been emitted yet (or the metric is not being scraped)."
      }
    },
    {
      "id": 2,
      "title": "Recovered proposals \u00b7 last 24h",
      "type": "stat",
      "description": "Valid call proposals reconstructed during the last 24 hours.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(agent_tool_call_text_recovered_total{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Model calls \u00b7 last 24h",
      "type": "stat",
      "description": "Model-call timer samples across selected Fred services.",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(llm_call_latency_ms_count{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool executions \u00b7 last 24h",
      "type": "stat",
      "description": "Executed native and recovered tool calls.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(agent_tool_latency_ms_count{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tool failures \u00b7 last 24h",
      "type": "stat",
      "description": "No data is normal until the first failure series exists.",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(agent_tool_failed_total{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recovered proposals by model \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "A rising count can show one model increasingly needs fallback recovery.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (model_name) (increase(agent_tool_call_text_recovered_total{service=~\"${service:regex}\"}[24h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recovered proposals per 100 model calls \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "Count per 100 model requests, not a percentage: one response may contain several calls.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (model_name) (increase(agent_tool_call_text_recovered_total{service=~\"${service:regex}\"}[24h])) / clamp_min(sum by (model_name) (increase(llm_call_latency_ms_count{service=~\"${service:regex}\"}[24h])), 1e-9)",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Model call latency p95 by model",
      "type": "timeseries",
      "description": "Provider-call latency excluding recovery parsing.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(llm_call_latency_ms_bucket{service=~\"${service:regex}\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Tool execution latency p95 by tool",
      "type": "timeseries",
      "description": "Tool latency across native and recovered calls.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(agent_tool_latency_ms_bucket{service=~\"${service:regex}\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "legendFormat": "{{tool_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Tool failures by tool \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "A missing series means no failure event has been emitted for that tool.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (tool_name) (increase(agent_tool_failed_total{service=~\"${service:regex}\"}[24h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{tool_name}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "fred",
    "agents",
    "runtime",
    "tool-recovery"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Fred service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(llm_call_latency_ms_count, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fred agent runtime",
  "uid": "fred-agent-runtime",
  "version": 1
}
