          "editorMode": "code",
          "expr": "sum(increase(agent_tool_failed_total{service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Recovered proposals by model \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "A rising count can show one model increasingly needs fallback recovery.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (model_name) (increase(agent_tool_call_text_recovered_total{service=~\"${service:regex}\"}[24h]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recovered proposals per 100 model calls \u00b7 rolling 24h",
      "type": "timeseries",
      "description": "Count per 100 model requests, not a percentage: one response may contain several calls.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum by (model_name) (increase(agent_tool_call_text_recovered_total{service=~\"${service:regex}\"}[24h])) / clamp_min(sum by (model_name) (increase(llm_call_latency_ms_count{service=~\"${service:regex}\"}[24h])), 1e-9)",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Model call latency p95 by model",
      "type": "timeseries",
      "description": "Provider-call latency excluding recovery parsing.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(llm_call_latency_ms_bucket{service=~\"${service:regex}\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Tool execution latency p95 by tool",
      "type": "timeseries",
      "description": "Tool latency across native and recovered calls.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
