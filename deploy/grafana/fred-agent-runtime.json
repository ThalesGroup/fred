          "expr": "sum(increase(llm_call_latency_ms_count{namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
