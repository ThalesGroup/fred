      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum by (model_name, llm_role) (rate(llm_calls_total{service=~\"${service:regex}\",status=\"error\"}[$__rate_interval])) / clamp_min(sum by (model_name, llm_role) (rate(llm_calls_total{service=~\"${service:regex}\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{model_name}} {{llm_role}}",
          "range": true
        }
      ]
    },
