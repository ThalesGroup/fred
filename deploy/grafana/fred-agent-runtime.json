          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "LLM stream diagnostics",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "These panels cover the shared ReAct/Deep model boundary, including native children; independent summarization, Graph and capability-internal calls are excluded. Observed chunks are LangChain callbacks, not tokens or network packets. A missing timing series means no observation, not zero latency. A blank panel means no matching observations or no scrape. Failures after HTTP 200 are possible. Compare gaps with event-loop lag and process load before attributing a failure to a gateway/provider. Active calls are per-process gauges; do not sum across time."
      }
    },
    {
      "id": 12,
      "title": "LLM terminal outcomes / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (model_name, llm_role, status, error_code) (rate(llm_calls_total{service=~\"${service:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{model_name}} {{llm_role}} {{status}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "LLM error rate (%)",
