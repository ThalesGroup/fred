{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Fred runtime metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Operational health of Fred ReAct/Deep model streams, tool calls and recovery; includes native Deep children.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read recovery",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Recovered calls are valid tool-call proposals reconstructed from completed Mistral responses. Later approval, budget, or execution checks can still stop a proposal. The counter is emitted once per reconstructed call, grouped by model; no user, session, or tool arguments are exported as labels. A blank recovery panel means no matching series has been emitted yet (or the metric is not being scraped).\n\nNamespace and Pod apply throughout. Keep All for labels absent from your scrape pipeline (including local metrics). Fred service selects runtime panels; the admission panel deliberately includes all services in the selected namespace/pods, including Swift Control Plane."
      }
    },
    {
      "id": 2,
      "title": "Recovered proposals \u00b7 last 24h",
      "type": "stat",
      "description": "Valid call proposals reconstructed during the last 24 hours.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(agent_tool_call_text_recovered_total{namespace=~\"${namespace:regex}\",pod=~\"${pod:regex}\",service=~\"${service:regex}\"}[24h]))",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Model calls \u00b7 last 24h",
      "type": "stat",
      "description": "Model-call timer samples across selected Fred services.",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
