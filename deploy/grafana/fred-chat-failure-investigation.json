{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource that scrapes the Fred backends.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "fred-chat-failures",
  "title": "Fred / Chat failure investigation",
  "description": "Terminal chat turn failures and observed ReAct and Deep LLM invocation failures.",
  "tags": [
    "fred",
    "reliability"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "timezone": "Europe/Paris",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({__name__=~\"agent_turn_completed_count|api_request_latency_ms_count\"}, cluster)",
        "query": {
          "query": "label_values({__name__=~\"agent_turn_completed_count|api_request_latency_ms_count\"}, cluster)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values({__name__=~\"agent_turn_completed_count|api_request_latency_ms_count\",cluster=~\"$cluster\"}, namespace)",
        "query": {
          "query": "label_values({__name__=~\"agent_turn_completed_count|api_request_latency_ms_count\",cluster=~\"$cluster\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "runtime",
        "label": "Chat runtime",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\"}, runtime_id)",
        "query": {
          "query": "label_values(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\"}, runtime_id)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "chat_lookback",
        "label": "Lookback",
        "type": "custom",
        "description": "Set the rolling window for the chat failure rate, turn volume, and HTTP 5xx rate by service. Auto adapts to the time range and Prometheus scrape interval.",
        "query": "Auto : $__rate_interval, 5m, 15m, 30m, 1h, 3h, 6h, 12h, 24h",
        "current": {
          "text": "Auto",
          "value": "$__rate_interval",
          "selected": true
        },
        "options": [
          {
            "text": "Auto",
            "value": "$__rate_interval",
            "selected": true
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "3h",
            "value": "3h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          }
        ]
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\"}, model_capability_id)",
        "query": {
          "query": "label_values(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\"}, model_capability_id)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "model_route",
        "type": "query",
        "label": "Route",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id=~\"$model\"}, model_route)",
        "query": {
          "query": "label_values(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id=~\"$model\"}, model_route)",
          "refId": "StandardVariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "reason",
        "type": "custom",
        "label": "Reason",
        "multi": false,
        "allowCustomValue": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "5xx : http_5xx, 429 : http_429, 400 : http_400, Other 4xx : http_other_4xx, Stream interrupted : stream_interrupted, Timeout or connection failure : timeout_or_connection, Context limit : context_limit, Tool or capability failure : tool_or_capability, Internal or unknown : internal_or_unknown, Reason unavailable : ^$"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Failed turns by reason",
      "description": "Each reason shows its share of all recorded chat turns in the lookback window. Hover for estimated failed and total turn counts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(sum by (failure_reason) (label_replace(increase(agent_turn_error_total{cluster=~\"$cluster\",namespace=~\"$namespace\",runtime_id=~\"$runtime\"}[${chat_lookback:raw}]), \"failure_reason\", \"unavailable\", \"failure_reason\", \"^$\"))) / on() group_left() ((sum(increase(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\",runtime_id=~\"$runtime\"}[${chat_lookback:raw}]))) > 0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "{{failure_reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(sum(increase(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\",runtime_id=~\"$runtime\"}[${chat_lookback:raw}])), \"window\", \"${chat_lookback:raw}\", \"__name__\", \".*\")",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "B",
          "legendFormat": "All turns (last {{window}})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace((sum(increase(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\",runtime_id=~\"$runtime\",finish_reason=\"error\"}[${chat_lookback:raw}])) or 0 * sum(increase(agent_turn_completed_count{cluster=~\"$cluster\",namespace=~\"$namespace\",runtime_id=~\"$runtime\"}[${chat_lookback:raw}]))), \"window\", \"${chat_lookback:raw}\", \"__name__\", \".*\")",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "C",
          "legendFormat": "Failed turns (last {{window}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "reasons"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "http_5xx"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "5xx"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2495C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http_429"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "429"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http_400"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "400"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FADE2A"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http_other_4xx"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Other 4xx"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#B877D9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "stream_interrupted"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stream interrupted"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "timeout_or_connection"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Timeout or connection failure"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3274D9"
                }
              }
            ]
