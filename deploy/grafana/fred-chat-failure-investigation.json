    {
      "id": 4,
      "type": "table",
      "title": "LLM invocations by model and route",
      "description": "Estimated counts over the selected time range. Total includes all terminal outcomes, including cancellations. Click a column heading to sort. Reason columns appear when that reason occurs in the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (model_capability_id, model_route) (label_replace((increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id!=\"\"}[$__range]) or label_replace(increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id=\"\"}[$__range]), \"model_capability_id\", \"$1\", \"model_name\", \"(.+)\")), \"model_route\", \"Route unavailable\", \"model_route\", \"^$\")), \"column\", \"Total\", \"model_route\", \".*\") or label_replace((sum by (model_capability_id, model_route) (label_replace((increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",status=\"error\",model_capability_id!=\"\"}[$__range]) or label_replace(increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",status=\"error\",model_capability_id=\"\"}[$__range]), \"model_capability_id\", \"$1\", \"model_name\", \"(.+)\")), \"model_route\", \"Route unavailable\", \"model_route\", \"^$\")) or 0 * sum by (model_capability_id, model_route) (label_replace((increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id!=\"\"}[$__range]) or label_replace(increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",model_capability_id=\"\"}[$__range]), \"model_capability_id\", \"$1\", \"model_name\", \"(.+)\")), \"model_route\", \"Route unavailable\", \"model_route\", \"^$\"))), \"column\", \"Failed\", \"model_route\", \".*\") or sum by (model_capability_id, model_route, column) (label_replace((sum by (model_capability_id, model_route, failure_reason) (label_replace(label_replace((increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",status=\"error\",model_capability_id!=\"\"}[$__range]) or label_replace(increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service