            "properties": [
              {
                "id": "displayName",
                "value": "Context limit"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CAB2D6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tool_or_capability"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tool or capability failure"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "internal_or_unknown"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Internal or unknown"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8E8E8E"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unavailable"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Reason unavailable"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C2C8D1"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(All|Failed) turns \\(/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "counts"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "hideZeros": false,
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "Where to look next",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**5xx** Check the gateway or provider. Consider a Fred banner if user impact is sustained.  \n**429** Check rate limits and quota.  \n**400** Check request shape, model settings and recent Fred changes.  \n**Other 4xx** Check credentials, permissions and the endpoint."
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM invocation failures",
      "description": "Estimated failed invocations by reason per lookback window. The Model, Route and Reason filters apply here. A successful Fred retry adds a separate successful invocation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (failure_reason) (label_replace(increase(llm_calls_total{cluster=~\"$cluster\",namespace=~\"$namespace\",service=~\"$runtime\",status=\"error\",model_capability_id=~\"$model\",model_route=~\"$model_route\",failure_reason=~\"${reason:raw}\"}[${chat_lookback:raw}]), \"failure_reason\", \"unavailable\", \"failure_reason\", \"^$\"))",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "{{failure_reason}}"
        }
      ],
      "fieldConfig": {
