{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesGroup/fred/libs/frontend/release/known-published-coordinates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "historicalVerification",
    "packages"
  ],
  "properties": {
    "$schema": { "const": "./known-published-coordinates.schema.json" },
    "schemaVersion": { "const": 1 },
    "historicalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runAttempt", "artifactId", "artifactZipSha256"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "artifactId": { "type": "integer", "minimum": 1 },
        "artifactZipSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate", "integrity", "publicationCommit"],
        "properties": {
          "coordinate": {
            "type": "string",
            "pattern": "^@fred-oss/[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
          },
          "publicationCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    }
  }
}
