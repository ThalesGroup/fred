{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesGroup/fred/libs/frontend/release/compatibility-baselines.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "baselines"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "memberId",
          "coordinate",
          "registry",
          "expected",
          "sourceReviewed",
          "verificationTrace"
        ],
        "properties": {
          "id": { "type": "string" },
          "memberId": { "type": "string" },
          "coordinate": { "type": "string" },
          "registry": { "type": "string", "format": "uri" },
          "expected": { "type": "object" },
          "sourceReviewed": { "const": true },
          "verificationTrace": { "type": "object" }
        }
      }
    }
  }
}
