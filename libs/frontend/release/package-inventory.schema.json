{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesGroup/fred/libs/frontend/release/package-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "members"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workspace", "builder", "validator", "consumer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "workspace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "builder": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "validator": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "consumer": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    }
  }
}
