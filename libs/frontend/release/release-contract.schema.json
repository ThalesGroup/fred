{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThalesGroup/fred/libs/frontend/release/release-contract.schema.json",
  "title": "FRED frontend package release contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "state",
    "registry",
    "distTag",
    "releaseToolchain",
    "maintainerApproval",
    "expectedProvenance",
    "packages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "state": {
      "enum": ["proposed", "fixture", "maintainer-confirmed"]
    },
    "registry": { "type": "string", "format": "uri" },
    "distTag": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "releaseToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm"],
      "properties": {
        "node": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "npm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "maintainerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeOwner",
        "owners",
        "bootstrapIdentity",
        "bootstrapAuthorityVerified",
        "registryAccess",
        "publishingPolicy"
      ],
      "properties": {
        "scopeOwner": { "type": ["string", "null"] },
        "owners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageApi", "sdkProtocol", "release", "npmPublishing"],
          "properties": {
            "packageApi": { "type": ["string", "null"] },
            "sdkProtocol": { "type": ["string", "null"] },
            "release": { "type": ["string", "null"] },
            "npmPublishing": { "type": ["string", "null"] }
          }
        },
        "bootstrapIdentity": { "type": ["string", "null"] },
        "bootstrapAuthorityVerified": { "type": "boolean" },
        "registryAccess": { "enum": ["public", null] },
        "publishingPolicy": { "enum": ["direct", "staged", null] }
      }
    },
    "expectedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "certificateIssuer"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "workflow": { "type": ["string", "null"] },
        "certificateIssuer": { "type": ["string", "null"] }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designTokens", "ui", "iframeSdk"],
      "properties": {
        "designTokens": { "$ref": "#/$defs/package" },
        "ui": { "$ref": "#/$defs/package" },
        "iframeSdk": { "$ref": "#/$defs/package" }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "name", "version", "expectedManifest"],
      "properties": {
        "workspace": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "expectedManifest": { "type": "object" }
      }
    }
  }
}
