// Pyright config used when opening project with workspace
// in vscode and by the pyright CLI
{
  "include": ["fred_core"],
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "standard",
  // Pydantic 2.14 uses TypeForm; basedpyright 1.31 gates its support here.
  "enableExperimentalFeatures": true,
  "reportMissingTypeStubs": false,
  "reportUnreachable": "warning",
  "extraPaths": ["../fred-pod"],
  "stubPath": "stubs"
}
