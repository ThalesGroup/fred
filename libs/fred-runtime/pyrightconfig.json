{
  "include": [
    "fred_runtime",
    "tests"
  ],
  "typeCheckingMode": "standard",
  "enableExperimentalFeatures": true,
  "reportMissingTypeStubs": false,
  "reportUnreachable": "warning",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "../fred-pod",
    "../fred-core",
    "../fred-sdk",
    "../capabilities/fred-capability-web-research",
    "../capabilities/fred-capability-document-access"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "../fred-pod",
        "../fred-core",
        "../fred-sdk",
        "../capabilities/fred-capability-web-research",
        "../capabilities/fred-capability-document-access"
      ]
    }
  ]
}
