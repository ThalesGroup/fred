{
  "images": [
    {
      "name": "fred-agents",
      "context": ".",
      "dockerfile": "apps/fred-agents/dockerfiles/Dockerfile-prod",
      "build_args": "",
      "publish": true
    },
    {
      "name": "knowledge-flow-backend",
      "context": ".",
      "dockerfile": "apps/knowledge-flow-backend/dockerfiles/Dockerfile-prod",
      "build_args": "PRODUCTION_FASTAPI_DOCS_ENABLED=false",
      "publish": true,
      "pr_inputs_reason": "API sources, shared libraries and build inputs. Ingestion has its own application and image.",
      "pr_inputs": [
        "apps/knowledge-flow-backend/**",
        "libs/fred-core/**",
        "libs/fred-pod/**",
        "scripts/**",
        "developer_tools/benchmarks/pdf_ingestion.py",
        "developer_tools/benchmarks/pdf_image_smoke.py",
        "alembic.ini",
        ".dockerignore",
        ".github/docker-images.json",
        ".github/workflows/Docker-images.yml",
        ".github/workflows/Check-docker-images.yml",
        "libs/fred-knowledge/**"
      ]
    },
    {
      "name": "knowledge-flow-worker",
      "context": ".",
      "dockerfile": "apps/knowledge-flow-worker/dockerfiles/Dockerfile-prod",
      "build_args": "PRODUCTION_FASTAPI_DOCS_ENABLED=false",
      "publish": true,
      "pr_inputs_reason": "Worker sources, common libraries, extraction fixtures and build inputs.",
      "pr_inputs": [
        "apps/knowledge-flow-worker/**",
        "libs/fred-core/**",
        "libs/fred-pod/**",
        "scripts/**",
        "developer_tools/benchmarks/pdf_ingestion.py",
        "developer_tools/benchmarks/pdf_image_smoke.py",
        "alembic.ini",
        ".dockerignore",
        ".github/docker-images.json",
        ".github/workflows/Docker-images.yml",
        ".github/workflows/Check-docker-images.yml",
        "libs/fred-knowledge/**"
      ]
    },
    {
      "name": "knowledge-flow-worker-pymupdf",
      "context": ".",
      "dockerfile": "apps/knowledge-flow-worker/dockerfiles/Dockerfile-prod",
      "build_args": "INSTALL_PYMUPDF=true",
      "publish": true,
      "pr_inputs_reason": "Worker sources, common libraries, extraction fixtures and build inputs.",
      "pr_inputs": [
        "apps/knowledge-flow-worker/**",
        "libs/fred-core/**",
        "libs/fred-pod/**",
        "scripts/**",
        "developer_tools/benchmarks/pdf_ingestion.py",
        "developer_tools/benchmarks/pdf_image_smoke.py",
        "alembic.ini",
        ".dockerignore",
        ".github/docker-images.json",
        ".github/workflows/Docker-images.yml",
        ".github/workflows/Check-docker-images.yml",
        "libs/fred-knowledge/**"
      ]
    },
    {
      "name": "control-plane-backend",
      "context": ".",
      "dockerfile": "apps/control-plane/dockerfiles/Dockerfile-prod",
      "build_args": "",
      "publish": true
    },
    {
      "name": "monitor",
      "context": ".",
      "dockerfile": "apps/monitor/dockerfiles/Dockerfile-prod",
      "build_args": "",
      "publish": false
    },
    {
      "name": "frontend",
      "context": ".",
      "dockerfile": "apps/frontend/dockerfiles/Dockerfile-prod",
      "build_args": "",
      "publish": true
    },
    {
      "name": "ws-bench",
      "context": "developer_tools/benchmarks",
      "dockerfile": "developer_tools/benchmarks/Dockerfile",
      "build_args": "",
      "publish": false,
      "scan": false
    }
  ],
  "pr_selection": {
    "rules": [
      {
        "paths": [
          "docs/**",
          "openspec/**",
          "*.md"
        ],
        "images": [],
        "reason": "Documentation only: no image copies docs/, openspec/ or root Markdown files. Markdown under apps/ or libs/ is code (a README can be package metadata)."
      },
      {
        "paths": ["apps/frontend/**", ".nvmrc"],
        "images": ["frontend"],
        "reason": "Only the frontend image consumes the application and repository Node baseline."
      },
      {
        "paths": [
          "libs/frontend/**"
        ],
        "images": [],
        "reason": "The npm package producer reads apps/frontend sources but no image copies it; Check pending request validates the packages."
      }
    ]
  },
  "excluded": [
    {
      "dockerfile": ".devcontainer/Dockerfile-devcontainer",
      "reason": "Prepared locally from .nvmrc and copies only .devcontainer/scripts/, so no change under apps/ or libs/ can break it. Its build time is dominated by third-party downloads (nodesource, github releases, astral.sh) that would make a required PR gate slow and flaky."
    },
    {
      "dockerfile": "apps/frontend/dockerfiles/Dockerfile-dev",
      "reason": "Stale: copies frontend/ and scripts/ from a pre-monorepo layout, so it cannot build from any context. Its only consumer, deploy/docker-compose/docker-compose.yml, points at an equally stale path. Delete or repair, then move it to images."
    },
    {
      "dockerfile": "apps/knowledge-flow-backend/dockerfiles/Dockerfile-dev",
      "reason": "Development helper with hot reload and developer dependencies. Release and isolated-runtime checks build Dockerfile-prod; this image is not published."
    }
  ]
}
