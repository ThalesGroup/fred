# Ignore node_modules (installed in Docker)
**/node_modules

# Ignore logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/*.out
**/*.err
**/*.pid

# Ignore the per-project alembic.ini symlinks (NOT the real file at the repo root).
# alembic.ini exists once, at the root; apps/control-plane-backend, apps/knowledge-flow-backend
# and libs/fred-runtime each carry a symlink to it purely for local-dev ergonomics (so a bare
# `alembic ...` works from the project directory). Kaniko copies symlinks verbatim instead of
# resolving them, so letting one into the build context lands a DANGLING link in the image.
# Keeping them out of the context means every Dockerfile-prod can just COPY the real root file
# to where it is needed — no per-image "rm the broken link first" dance.
apps/*/alembic.ini
libs/*/alembic.ini

# Ignore build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
apps/control-plane-backend/control_plane_backend/applications/catalog.generated.json

# Ignore environment files
**/.env
**/.env.local
**/.env.*.local

# Ignore Docker-related files
**/Dockerfile*
**/dockerfiles
**/.dockerignore
!apps/frontend/dockerfiles
!apps/frontend/dockerfiles/docker-entrypoint.sh

# macOS-specific files
**/.DS_Store

# Git-related files
**/.git
**/.gitignore
**/.github

# VScode-related files
**/.vscode

# Local development related files
**/target/
**/configuration.yaml
**/configuration_*.yaml

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
**/venv/
**/.env/
**/*.env
**/.venv/

# Tests and coverage reports
**/.coverage
**/*.cover
**/.coverage.*
**/.cache/
**/pytest_cache/
**/.tox/
**/.nox/
**/tests

# Jupyter Notebook checkpoints
**/.ipynb_checkpoints/

# macOS-specific files
**/.DS_Store

# Editor and IDE config files
**/*.swp
**/*.swo
**/*.idea/
**/.vscode/
**/*.bak

# Local database files
**/*.sqlite3
**/db.sqlite3
**/migrations/

# Temporary files
**/*.tmp
**/*.temp
**/tmp/
