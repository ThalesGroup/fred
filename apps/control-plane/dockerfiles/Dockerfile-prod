# -----------------------------------------------------------------------------
# BUILD STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/rust:1.99.0-slim-trixie AS builder

# The Temporal client compiles protobuf definitions at build time; libprotobuf-dev
# ships the google/protobuf well-known types they import.
RUN apt-get update && \
    apt-get install -y --no-install-recommends protobuf-compiler libprotobuf-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Cache dependency compilation, including the small embedded agent library.
COPY Cargo.toml Cargo.lock ./
COPY agent/Cargo.toml ./agent/Cargo.toml
COPY agent/src ./agent/src
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release --locked && \
    rm -rf src

# Migrations and the OpenFGA model are embedded in the binary at compile time.
COPY migrations ./migrations
COPY openfga ./openfga
COPY src ./src
RUN touch src/main.rs && cargo build --release --locked

# -----------------------------------------------------------------------------
# FINAL STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/debian:13.1-slim

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME}

COPY --from=builder /workspace/target/release/control-plane /usr/local/bin/control-plane

# configuration.yaml and .env are mounted under /app/config by the chart.
WORKDIR /app

USER ${USER_NAME}

EXPOSE 8222

ENTRYPOINT ["control-plane"]
CMD ["serve"]
