# -----------------------------------------------------------------------------
# BUILD STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/rust:1.99.0-slim-trixie AS builder

# The Temporal client compiles protobuf definitions at build time; libprotobuf-dev
# ships the google/protobuf well-known types they import.
RUN apt-get update && \
    apt-get install -y --no-install-recommends protobuf-compiler libprotobuf-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Build from the repository root: both applications share the internal Rust SDK.
COPY Cargo.toml Cargo.lock ./
COPY libs/fred-rust-sdk ./libs/fred-rust-sdk
COPY apps/monitor/Cargo.toml ./apps/monitor/Cargo.toml
COPY apps/monitor/src ./apps/monitor/src
COPY apps/control-plane/Cargo.toml ./apps/control-plane/Cargo.toml
COPY apps/control-plane/agent ./apps/control-plane/agent
WORKDIR /workspace/apps/control-plane
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release --locked -p control-plane && \
    rm -rf src

# Migrations are embedded in the binary at compile time.
COPY apps/control-plane/migrations ./migrations
COPY apps/control-plane/src ./src
RUN touch src/main.rs && cargo build --release --locked -p control-plane

# -----------------------------------------------------------------------------
# FINAL STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/debian:13.1-slim

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME}

COPY --from=builder /workspace/target/release/control-plane /usr/local/bin/control-plane

# configuration.yaml and .env are mounted under /app/config by the chart.
WORKDIR /app

USER ${USER_NAME}

EXPOSE 8222

ENTRYPOINT ["control-plane"]
CMD ["serve"]
