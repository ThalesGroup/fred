{
  "$defs": {
    "AppConfig": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "bootstrap_token_env_var": {
          "description": "Root-bootstrap secret, read from this environment variable.",
          "type": [
            "string",
            "null"
          ]
        },
        "gcu_version": {
          "description": "Active terms version; null disables consent gating.",
          "type": [
            "string",
            "null"
          ]
        },
        "log_format": {
          "$ref": "#/$defs/LogFormat",
          "description": "`json` (one object per stdout line) or `text`, as the Python APIs' `app.log_format`."
        },
        "log_level": {
          "type": "string"
        },
        "port": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "base_url",
        "port"
      ],
      "type": "object"
    },
    "ClaimsConfig": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "family_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "given_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "uid": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "workers": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkerIdentity"
          },
          "description": "Logical pod -> verified workload. Separate identities prevent cross-pod consumption.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Configuration": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "$ref": "#/$defs/AppConfig"
        },
        "platform": {
          "$ref": "#/$defs/PlatformConfig"
        },
        "policies": {
          "$ref": "#/$defs/Policies"
        },
        "scheduler": {
          "$ref": "#/$defs/SchedulerConfig"
        },
        "security": {
          "$ref": "#/$defs/SecurityConfig"
        },
        "storage": {
          "$ref": "#/$defs/StorageConfig"
        }
      },
      "required": [
        "app",
        "security",
        "storage",
        "scheduler"
      ],
      "type": "object"
    },
    "ContentConfig": {
      "additionalProperties": false,
      "properties": {
        "access_key_env_var": {
          "type": "string"
        },
        "allow_insecure": {
          "type": "boolean"
        },
        "bucket": {
          "type": "string"
        },
        "cleanup_enabled": {
          "description": "Disable admission and cleanup while restoring a database/storage pair.",
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "force_path_style": {
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/ContentLimits"
        },
        "prefix": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "secret_key_env_var": {
          "type": "string"
        },
        "temp_dir": {
          "type": "string"
        },
        "uploads_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "endpoint",
        "bucket"
      ],
      "type": "object"
    },
    "ContentLimits": {
      "additionalProperties": false,
      "properties": {
        "cleanup_backlog_bytes": {
          "default": 1073741824,
          "format": "int64",
          "type": "integer"
        },
        "cleanup_batch": {
          "default": 100,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "cleanup_interval_seconds": {
          "default": 30,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "conversation_bytes": {
          "default": 1073741824,
          "description": "Source file bytes, excluding retired documents and failed uploads.",
          "format": "int64",
          "type": "integer"
        },
        "conversation_files": {
          "default": 100,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "downloads": {
          "default": 8,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "file_bytes": {
          "default": 104857600,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "idle_seconds": {
          "default": 30,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "organization_bytes": {
          "default": 5368709120,
          "format": "int64",
          "type": "integer"
        },
        "organization_total_bytes": {
          "default": null,
          "description": "Optional combined ceiling across all storage spaces in an organization.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "personal_bytes": {
          "default": 5368709120,
          "format": "int64",
          "type": "integer"
        },
        "receipt_retention_days": {
          "default": 7,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "s3_seconds": {
          "default": 120,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "team_bytes": {
          "default": 5368709120,
          "format": "int64",
          "type": "integer"
        },
        "temp_bytes": {
          "default": 838860800,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "transfer_seconds": {
          "default": 300,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "uploads": {
          "default": 8,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CredentialAuthority": {
      "enum": [
        "discovery_only",
        "discovery_and_inference"
      ],
      "type": "string"
    },
    "DeclaredModel": {
      "additionalProperties": false,
      "description": "Chat is guaranteed by this declaration, except for an offer the source attests in\n`embedding_models`; an absent fact stays unknown.",
      "properties": {
        "context_window_tokens": {
          "format": "int64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Exact upstream identifier, never normalized.",
          "type": "string"
        },
        "max_input_tokens": {
          "format": "int64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output_tokens": {
          "format": "int64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DirectoryDelegation": {
      "additionalProperties": false,
      "description": "Shared identity classification and runtime-resolver delegation settings.\nNames and defaults match Python security.delegation; acceptance is route-scoped.",
      "properties": {
        "accept_delegated_calls": {
          "default": false,
          "description": "Accept person/run/agent assertions at runtime and decision endpoints.",
          "type": "boolean"
        },
        "audience": {
          "default": "fred-delegation",
          "type": "string"
        },
        "caller_role": {
          "default": "delegation_caller",
          "type": "string"
        },
        "caller_roles_claim": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "service_accounts_only": {
          "default": false,
          "description": "Keycloak client-credentials markers are mandatory when enabled.",
          "type": "boolean"
        },
        "user_clients": {
          "default": [],
          "description": "Human login clients, in addition to security.user.client_id, cannot delegate.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DirectoryKind": {
      "enum": [
        "keycloak",
        "local"
      ],
      "type": "string"
    },
    "DiscoveryAuthentication": {
      "oneOf": [
        {
          "properties": {
            "mode": {
              "enum": [
                "public"
              ],
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "properties": {
            "accept_inference_authority": {
              "type": "boolean"
            },
            "authority": {
              "$ref": "#/$defs/CredentialAuthority"
            },
            "mode": {
              "enum": [
                "bearer"
              ],
              "type": "string"
            },
            "provider_scopes": {
              "description": "Actual provider scopes, reviewed by the platform; a separate key proves nothing.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "secret_env_var": {
              "type": "string"
            }
          },
          "required": [
            "secret_env_var",
            "provider_scopes",
            "authority",
            "mode"
          ],
          "type": "object"
        }
      ]
    },
    "InferenceCredentialBinding": {
      "additionalProperties": false,
      "description": "Local deployment attestation, independent of the received admission.",
      "properties": {
        "api_key_env": {
          "type": "string"
        },
        "api_root": {
          "type": "string"
        },
        "credential_binding": {
          "type": "string"
        }
      },
      "required": [
        "credential_binding",
        "api_root",
        "api_key_env"
      ],
      "type": "object"
    },
    "LifecycleConfig": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "default": 100,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "sweep_interval": {
          "default": "PT10M",
          "type": "string"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalConfig",
          "default": {
            "connect_timeout_seconds": 5,
            "host": "localhost:7233",
            "namespace": "default",
            "rpc_timeout_seconds": 10,
            "task_queue": "control-plane-lifecycle",
            "workflow_id_prefix": "control-plane-lifecycle"
          }
        }
      },
      "type": "object"
    },
    "LogFormat": {
      "enum": [
        "json",
        "text"
      ],
      "type": "string"
    },
    "M2mConfig": {
      "additionalProperties": false,
      "description": "Issuer plus outbound directory credentials, used only when `enabled`.",
      "properties": {
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "realm_url": {
          "type": "string"
        },
        "secret_env_var": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "realm_url",
        "enabled"
      ],
      "type": "object"
    },
    "McpCredentialBinding": {
      "additionalProperties": false,
      "description": "Local deployment attestation; names only. Never sent to browsers or admission.",
      "properties": {
        "credential_binding": {
          "type": "string"
        },
        "secret_env": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "credential_binding",
        "url",
        "secret_env"
      ],
      "type": "object"
    },
    "ModelAuth": {
      "additionalProperties": false,
      "description": "Authentication facts only: the secrets stay in the workload's local binding.",
      "properties": {
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gateway_key_header": {
          "description": "Name of the header carrying a gateway key, with any kind.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ModelAuthKind"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenant_id": {
          "description": "Required with kind `entra`, forbidden otherwise, like `client_id` and `scope`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ModelAuthKind": {
      "enum": [
        "none",
        "api_key",
        "entra"
      ],
      "type": "string"
    },
    "ModelConnection": {
      "additionalProperties": false,
      "description": "One destination, independent of the vendor: protocol, address and authentication.\nMirrored by `fred_sdk.contracts.weaver`; `inference_connections.json` pins both.",
      "properties": {
        "api_root": {
          "description": "Separately approved canonical root; never derived from a discovery URL.",
          "type": "string"
        },
        "api_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "$ref": "#/$defs/ModelAuth"
        },
        "credential_binding": {
          "description": "Source-bound workload provisioning reference; never a credential value.",
          "type": "string"
        },
        "dialect": {
          "$ref": "#/$defs/ModelDialect"
        },
        "route": {
          "$ref": "#/$defs/ModelRoute"
        },
        "wire": {
          "$ref": "#/$defs/ModelWire"
        }
      },
      "required": [
        "credential_binding",
        "api_root",
        "wire",
        "route",
        "dialect",
        "auth"
      ],
      "type": "object"
    },
    "ModelDialect": {
      "enum": [
        "openai",
        "openai_compatible",
        "mistral"
      ],
      "type": "string"
    },
    "ModelOfferKey": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "upstream_model_id": {
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "upstream_model_id"
      ],
      "type": "object"
    },
    "ModelRoute": {
      "enum": [
        "standard",
        "azure_deployment"
      ],
      "type": "string"
    },
    "ModelSource": {
      "additionalProperties": false,
      "description": "Platform approval of one source. Contains references only, never secret values.",
      "properties": {
        "allow_insecure_http": {
          "description": "Explicit platform approval for internal HTTP routes; HTTPS is the default.",
          "type": "boolean"
        },
        "embedding_models": {
          "description": "Platform attestation: these exact offers compute embeddings and are never chat.\nProvider model lists do not establish this aptitude.",
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "inference": {
          "$ref": "#/$defs/ModelConnection"
        },
        "inventory": {
          "$ref": "#/$defs/SourceInventory"
        },
        "revision": {
          "description": "Strictly increase for every configuration change, including secret rotation.",
          "format": "int64",
          "type": "integer"
        },
        "source_id": {
          "type": "string"
        },
        "visibility_scope": {
          "description": "Stable provider account, model namespace and list visibility contract.\nA changed account/namespace/scope needs a new source_id, even with the same URL.",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "inventory",
        "inference",
        "visibility_scope"
      ],
      "type": "object"
    },
    "ModelWire": {
      "description": "Generation protocol only. An attested embedding offer is always called at\n`{api_root}/embeddings`, the one embedding endpoint of these APIs.",
      "enum": [
        "openai_chat",
        "openai_responses"
      ],
      "type": "string"
    },
    "OrganizationModels": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "oneOf": [
            {
              "$ref": "#/$defs/ModelOfferKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "embedding": {
          "oneOf": [
            {
              "$ref": "#/$defs/ModelOfferKey",
              "description": "Embedding model of the organization's documents, within its permitted offers."
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "oneOf": [
            {
              "$ref": "#/$defs/ModelOfferKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "organization": {
          "description": "Exact existing organization name, resolved using the provisioning SQL lookup.",
          "type": "string"
        },
        "permitted": {
          "items": {
            "$ref": "#/$defs/ModelOfferKey"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "reasoning_enabled": {
          "items": {
            "$ref": "#/$defs/ModelOfferKey"
          },
          "maxItems": 4096,
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "vision": {
          "oneOf": [
            {
              "$ref": "#/$defs/ModelOfferKey",
              "description": "Optional model describing document images, within its permitted chat offers."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization",
        "sources",
        "permitted"
      ],
      "type": "object"
    },
    "PlatformConfig": {
      "additionalProperties": false,
      "properties": {
        "capability_preparation": {
          "$ref": "#/$defs/Config"
        },
        "inference_credentials": {
          "items": {
            "$ref": "#/$defs/InferenceCredentialBinding"
          },
          "type": "array"
        },
        "knowledge_flow_url": {
          "description": "Optional server-owned KF base URL; enables Ralph's fixed document search tool.",
          "type": [
            "string",
            "null"
          ]
        },
        "mcp_credentials": {
          "items": {
            "$ref": "#/$defs/McpCredentialBinding"
          },
          "type": "array"
        },
        "model_sources": {
          "items": {
            "$ref": "#/$defs/ModelSource"
          },
          "type": "array"
        },
        "organization_models": {
          "items": {
            "$ref": "#/$defs/OrganizationModels"
          },
          "maxItems": 64,
          "type": "array"
        },
        "runtime_catalog_sources": {
          "items": {
            "$ref": "#/$defs/RuntimeCatalogSource"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "properties": {
        "purge_catalog_path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PostgresConfig": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "database",
        "username"
      ],
      "type": "object"
    },
    "ProcessingConfig": {
      "additionalProperties": false,
      "properties": {
        "derived": {
          "$ref": "#/$defs/ContentConfig"
        },
        "enabled": {
          "type": "boolean"
        },
        "limits": {
          "$ref": "#/$defs/ProcessingLimits"
        },
        "temporal": {
          "$ref": "#/$defs/TemporalConfig"
        },
        "worker": {
          "$ref": "#/$defs/WorkerIdentity"
        },
        "worker_contract_file": {
          "description": "Generated by KF features.scheduler.export_contract from the deployed KF configuration.",
          "type": "string"
        }
      },
      "required": [
        "temporal",
        "worker_contract_file",
        "worker",
        "derived"
      ],
      "type": "object"
    },
    "ProcessingLimits": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "default": 2000,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "batch": {
          "default": 20,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "chunks": {
          "default": 100000,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "execution_seconds": {
          "default": 86400,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "default": 536870912,
          "format": "int64",
          "type": "integer"
        },
        "pending": {
          "default": 1000,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        },
        "poll_seconds": {
          "default": 5,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "queue_seconds": {
          "default": 3600,
          "format": "int32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Qualification": {
      "enum": [
        "chat_source",
        "mixed_capabilities_v1"
      ],
      "type": "string"
    },
    "RuntimeCatalogSource": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "public_base_url": {
          "description": "Platform-approved browser ingress path; never inferred from the internal URL.\nOmit to leave browser execution/history routing unavailable.",
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "required": [
        "runtime_id",
        "base_url"
      ],
      "type": "object"
    },
    "SchedulerConfig": {
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "$ref": "#/$defs/LifecycleConfig"
        },
        "processing": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProcessingConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SecurityConfig": {
      "additionalProperties": false,
      "properties": {
        "authorized_origins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delegation": {
          "$ref": "#/$defs/DirectoryDelegation"
        },
        "m2m": {
          "oneOf": [
            {
              "$ref": "#/$defs/M2mConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "$ref": "#/$defs/UserConfig"
        },
        "user_directory": {
          "$ref": "#/$defs/DirectoryKind"
        }
      },
      "required": [
        "user"
      ],
      "type": "object"
    },
    "SourceInventory": {
      "description": "Where this source's offers come from. A declared list replaces discovery for its\nsource, never supplements it, and both publish through the same refresh.",
      "oneOf": [
        {
          "properties": {
            "authentication": {
              "$ref": "#/$defs/DiscoveryAuthentication"
            },
            "complete_inventory_guaranteed": {
              "description": "Platform attests that an unpaginated response lists the entire visibility scope.\nWithout this guarantee, discovery cannot publish an authoritative inventory.",
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "discovered"
              ],
              "type": "string"
            },
            "qualification": {
              "$ref": "#/$defs/Qualification"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "authentication",
            "qualification",
            "complete_inventory_guaranteed",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "declared"
              ],
              "type": "string"
            },
            "models": {
              "items": {
                "$ref": "#/$defs/DeclaredModel"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "models",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "StorageConfig": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "oneOf": [
            {
              "$ref": "#/$defs/ContentConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "postgres": {
          "$ref": "#/$defs/PostgresConfig"
        }
      },
      "required": [
        "postgres"
      ],
      "type": "object"
    },
    "TemporalConfig": {
      "additionalProperties": false,
      "properties": {
        "connect_timeout_seconds": {
          "default": 5,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "default": "localhost:7233",
          "type": "string"
        },
        "namespace": {
          "default": "default",
          "type": "string"
        },
        "rpc_timeout_seconds": {
          "default": 10,
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "task_queue": {
          "default": "control-plane-lifecycle",
          "type": "string"
        },
        "workflow_id_prefix": {
          "default": "control-plane-lifecycle",
          "type": "string"
        }
      },
      "type": "object"
    },
    "UserConfig": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "claims": {
          "$ref": "#/$defs/ClaimsConfig"
        },
        "client_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "jwks_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "realm_url": {
          "type": "string"
        },
        "roles_claim": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "realm_url",
        "client_id"
      ],
      "type": "object"
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "audience",
        "client_id"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/Configuration",
  "$schema": "https://json-schema.org/draft-07/schema#"
}
