ARG PYTHON_VERSION=3.12.15

# -----------------------------------------------------------------------------
# PYTHON BASE: Ubuntu LTS with CPython from uv's standalone builds, so the
# interpreter version is pinned here rather than following the distribution.
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM mirror.gcr.io/ubuntu:24.04 AS python-install
ARG PYTHON_VERSION
COPY --from=uv /uv /usr/local/bin/uv
# Behind TLS inspection (e.g. Zscaler), `make docker-build` lends the host's CA
# bundle as the `ca-bundle` secret; without it, uv keeps its own roots.
RUN --mount=type=secret,id=ca-bundle \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    UV_PYTHON_INSTALL_DIR=/opt/python uv python install ${PYTHON_VERSION}

FROM mirror.gcr.io/ubuntu:24.04 AS python-base
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
# The packages python:slim provides. Ubuntu's own `ubuntu` user holds UID/GID
# 1000, which fred-user keeps.
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates netbase tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    userdel -r ubuntu
COPY --from=python-install /opt/python /opt/python
# Venvs record /usr/local/bin as their home; ensurepip bootstraps them, so the
# interpreter's own pip is not needed.
RUN ln -s /opt/python/cpython-${PYTHON_VERSION}-*/bin/python3.12 /usr/local/bin/python3 && \
    ln -s python3 /usr/local/bin/python && \
    python3 -m pip uninstall --yes --break-system-packages pip
# Compile the venv's bytecode at build time: the image is read back fresh at
# every container start, so bytecode compiled at import is lost on each
# restart, and compiling the whole venv outlasts the liveness probe.
ENV UV_COMPILE_BYTECODE=1

# -----------------------------------------------------------------------------
# BUILD STAGE
# -----------------------------------------------------------------------------
FROM python-base AS builder

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl make && \
    rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/app/venv
ENV PATH="/app/venv/bin:$PATH"

WORKDIR /workspace/apps/fred-agents

# Third-party dependencies only, from the manifests alone, so this layer changes
# only with the lock. The local packages are installed in the final stage.
COPY apps/fred-agents/Makefile ./
COPY apps/fred-agents/pyproject.toml apps/fred-agents/uv.lock* ./
COPY scripts/makefiles /workspace/scripts/makefiles
COPY libs/fred-pod/pyproject.toml /workspace/libs/fred-pod/
COPY libs/fred-core/pyproject.toml /workspace/libs/fred-core/
COPY libs/fred-runtime/pyproject.toml /workspace/libs/fred-runtime/
COPY libs/fred-sdk/pyproject.toml /workspace/libs/fred-sdk/
COPY libs/capabilities/fred-capability-writable-document/pyproject.toml /workspace/libs/capabilities/fred-capability-writable-document/
COPY libs/capabilities/fred-capability-ppt-filler/pyproject.toml /workspace/libs/capabilities/fred-capability-ppt-filler/
COPY libs/capabilities/fred-capability-platform-ops/pyproject.toml /workspace/libs/capabilities/fred-capability-platform-ops/
COPY libs/capabilities/fred-capability-html-artifact/pyproject.toml /workspace/libs/capabilities/fred-capability-html-artifact/
COPY libs/capabilities/fred-capability-team-wiki/pyproject.toml /workspace/libs/capabilities/fred-capability-team-wiki/
COPY libs/capabilities/fred-capability-documents/pyproject.toml /workspace/libs/capabilities/fred-capability-documents/
COPY libs/capabilities/fred-capability-document-access/pyproject.toml /workspace/libs/capabilities/fred-capability-document-access/
COPY libs/capabilities/fred-capability-mcp/pyproject.toml /workspace/libs/capabilities/fred-capability-mcp/
COPY libs/capabilities/fred-capability-web-research/pyproject.toml /workspace/libs/capabilities/fred-capability-web-research/

RUN --mount=type=secret,id=ca-bundle \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    make prod VENV=/app/venv TARGET=/app/target UV_SYNC_ARGS="--no-install-project --no-install-local"

# -----------------------------------------------------------------------------
# FINAL STAGE
# -----------------------------------------------------------------------------
FROM python-base

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

# The PPT-filler preview needs Impress at runtime. The headless package keeps
# PDF export without the full office suite, GUI/media stack or system Python.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libreoffice-impress-nogui && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME}

COPY --from=builder --chown=${USER_ID}:${GROUP_ID} /app/venv /app/venv

ENV PATH="/app/venv/bin:$PATH"

WORKDIR /app

# The local packages, installed in editable mode from their source roots under
# the same `/workspace/...` paths, which the image keeps. A change there only
# redoes this small install: the venv copied above stays cached.
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/pyproject.toml apps/fred-agents/uv.lock /workspace/apps/fred-agents/
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/README.md /workspace/apps/fred-agents/README.md
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/fred_agents /workspace/apps/fred-agents/fred_agents
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-pod /workspace/libs/fred-pod
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-core /workspace/libs/fred-core
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-runtime /workspace/libs/fred-runtime
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-sdk /workspace/libs/fred-sdk
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-writable-document /workspace/libs/capabilities/fred-capability-writable-document
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-ppt-filler /workspace/libs/capabilities/fred-capability-ppt-filler
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-platform-ops /workspace/libs/capabilities/fred-capability-platform-ops
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-html-artifact /workspace/libs/capabilities/fred-capability-html-artifact
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-team-wiki /workspace/libs/capabilities/fred-capability-team-wiki
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-documents /workspace/libs/capabilities/fred-capability-documents
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-document-access /workspace/libs/capabilities/fred-capability-document-access
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-mcp /workspace/libs/capabilities/fred-capability-mcp
COPY --chown=${USER_ID}:${GROUP_ID} libs/capabilities/fred-capability-web-research /workspace/libs/capabilities/fred-capability-web-research
RUN --mount=type=secret,id=ca-bundle \
    cd /workspace/apps/fred-agents && \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    UV_PROJECT_ENVIRONMENT=/app/venv SSL_CERT_FILE=${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt} \
    /app/venv/bin/uv sync --locked --no-default-groups --no-cache

# pip is only needed for the builder bootstrap; remove it and its vendored
# dependencies after the last install. Runtime packages stay locked.
RUN /app/venv/bin/python -m pip uninstall --yes pip

# Packaged procedures and their source path stay read-only for the runtime UID.
RUN chown -R root:root /workspace/libs/fred-runtime && \
    chmod -R a-w /workspace/libs/fred-runtime && \
    chown root:root /workspace /workspace/libs && \
    chmod a-w /workspace /workspace/libs

# alembic.ini is a real file only at the repo root; the per-project ones are dev-only
# symlinks kept out of the build context (see .dockerignore), because Kaniko would copy
# them verbatim — which is exactly the dangling link this image used to ship (#2289).
# `python -m fred_runtime migrate` (the Helm migration hook) upgrades fred-runtime's tree
# then every installed capability's own tree, all rooted under /workspace/libs/..., so the
# ini belongs beside fred-runtime's pyproject.toml whose [tool.alembic] script_location
# resolves to /workspace/libs/fred-runtime/fred_runtime/migrations.
COPY --chown=${USER_ID}:${GROUP_ID} alembic.ini /workspace/libs/fred-runtime/alembic.ini

# Deployments provide .env and configuration under /app/config. The model catalog
# ships as a default; the Fred chart mounts its override at the same path.
# The platform prompt and empty external MCP catalog also ship in-image.
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/config/models_catalog.yaml /app/config/models_catalog.yaml
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/config/platform_prompt.json /app/config/platform_prompt.json
COPY --chown=${USER_ID}:${GROUP_ID} apps/fred-agents/config/mcp_catalog_external.yaml /app/config/mcp_catalog_external.yaml

USER ${USER_NAME}

EXPOSE 8000

ENTRYPOINT ["python", "-m", "fred_agents"]
