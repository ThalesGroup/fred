ARG BASE_IMAGE=ghcr.io/thalesgroup/fred-agent/fred-agents-base:swift-dev
FROM ${BASE_IMAGE} AS base

USER root

# Capabilities and the default agents are specific to this image.
COPY --chown=1000:1000 apps/fred-agents/pyproject.toml apps/fred-agents/uv.lock apps/fred-agents/README.md /workspace/apps/fred-agents/
COPY --chown=1000:1000 apps/fred-agents/fred_agents /workspace/apps/fred-agents/fred_agents
COPY --chown=1000:1000 libs/capabilities/fred-capability-writable-document /workspace/libs/capabilities/fred-capability-writable-document
COPY --chown=1000:1000 libs/capabilities/fred-capability-ppt-filler /workspace/libs/capabilities/fred-capability-ppt-filler
COPY --chown=1000:1000 libs/capabilities/fred-capability-word-template /workspace/libs/capabilities/fred-capability-word-template
COPY --chown=1000:1000 libs/capabilities/fred-capability-platform-ops /workspace/libs/capabilities/fred-capability-platform-ops
COPY --chown=1000:1000 libs/capabilities/fred-capability-html-artifact /workspace/libs/capabilities/fred-capability-html-artifact
COPY --chown=1000:1000 libs/capabilities/fred-capability-team-wiki /workspace/libs/capabilities/fred-capability-team-wiki
COPY --chown=1000:1000 libs/capabilities/fred-capability-documents /workspace/libs/capabilities/fred-capability-documents
COPY --chown=1000:1000 libs/capabilities/fred-capability-document-access /workspace/libs/capabilities/fred-capability-document-access
COPY --chown=1000:1000 libs/capabilities/fred-capability-mcp /workspace/libs/capabilities/fred-capability-mcp
COPY --chown=1000:1000 libs/capabilities/fred-capability-web-research /workspace/libs/capabilities/fred-capability-web-research
COPY --chown=1000:1000 libs/capabilities/fred-capability-spreadsheet /workspace/libs/capabilities/fred-capability-spreadsheet
RUN --mount=type=secret,id=ca-bundle \
    cd /workspace/apps/fred-agents && \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    SSL_CERT_FILE=${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt} \
    uv sync --locked --no-default-groups --group capabilities --no-cache

COPY --chown=1000:1000 apps/fred-agents/config/models_catalog.yaml /app/config/models_catalog.yaml
COPY --chown=1000:1000 apps/fred-agents/config/platform_prompt.json /app/config/platform_prompt.json
COPY --chown=1000:1000 apps/fred-agents/config/mcp_catalog_external.yaml /app/config/mcp_catalog_external.yaml

USER fred-user
EXPOSE 8000
ENTRYPOINT ["python", "-m", "fred_agents"]
