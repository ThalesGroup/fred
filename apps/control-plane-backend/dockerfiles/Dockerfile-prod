# -----------------------------------------------------------------------------
# BUILD STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/python:3.12.15-slim-trixie AS builder

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl make && \
    rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/app/venv
ENV PATH="/app/venv/bin:$PATH"

WORKDIR /workspace/apps/control-plane-backend

# Third-party dependencies only, from the manifests alone, so this layer changes
# only with the lock. The local packages are installed in the final stage.
COPY apps/control-plane-backend/Makefile ./
COPY apps/control-plane-backend/pyproject.toml apps/control-plane-backend/uv.lock* ./
COPY scripts/makefiles /workspace/scripts/makefiles
COPY libs/fred-pod/pyproject.toml /workspace/libs/fred-pod/
COPY libs/fred-core/pyproject.toml /workspace/libs/fred-core/
COPY libs/fred-sdk/pyproject.toml /workspace/libs/fred-sdk/

RUN make prod VENV=/app/venv TARGET=/app/target UV_SYNC_ARGS="--no-install-project --no-install-local"

# -----------------------------------------------------------------------------
# FINAL STAGE
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/python:3.12.15-slim-trixie

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG PRODUCTION_FASTAPI_DOCS_ENABLED=false

RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME}

COPY --from=builder --chown=${USER_ID}:${GROUP_ID} /app/venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
ENV PRODUCTION_FASTAPI_DOCS_ENABLED=${PRODUCTION_FASTAPI_DOCS_ENABLED}

WORKDIR /app

# The local packages, installed in editable mode from their source roots under
# `/workspace/...`, which the image keeps. A change there only redoes this small
# install: the venv copied above stays cached.
COPY --chown=${USER_ID}:${GROUP_ID} apps/control-plane-backend/pyproject.toml apps/control-plane-backend/uv.lock /workspace/apps/control-plane-backend/
COPY --chown=${USER_ID}:${GROUP_ID} apps/control-plane-backend/README.md /workspace/apps/control-plane-backend/README.md
COPY --chown=${USER_ID}:${GROUP_ID} apps/control-plane-backend/control_plane_backend /workspace/apps/control-plane-backend/control_plane_backend
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-pod /workspace/libs/fred-pod
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-core /workspace/libs/fred-core
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-sdk /workspace/libs/fred-sdk
RUN cd /workspace/apps/control-plane-backend && \
    UV_PROJECT_ENVIRONMENT=/app/venv SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    /app/venv/bin/uv sync --locked --no-default-groups --no-cache

# Runtime uses uv; pip and its vendored libraries are only needed during bootstrap.
RUN /app/venv/bin/python -m pip uninstall --yes pip && \
    /usr/local/bin/python -m pip uninstall --yes pip

COPY --chown=${USER_ID}:${GROUP_ID} apps/control-plane-backend/. /app/

# alembic.ini is a real file only at the repo root; the per-project ones are dev-only
# symlinks kept out of the build context (see .dockerignore), because Kaniko would copy
# them verbatim and land a dangling link here. Ship the real file next to /app/pyproject.toml,
# whose [tool.alembic] script_location resolves to /app/alembic.
COPY --chown=${USER_ID}:${GROUP_ID} alembic.ini /app/alembic.ini

USER ${USER_NAME}

EXPOSE 8222

ENTRYPOINT ["uvicorn", "control_plane_backend.main:create_app", "--factory"]
CMD ["--port", "8222", "--host", "0.0.0.0", "--log-level", "info", "--loop", "asyncio"]
