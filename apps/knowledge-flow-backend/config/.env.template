# This file contains the environment variables for the application

# -----------------------------------------------------------------------------
# CONFIGURATION
# -----------------------------------------------------------------------------

CONFIG_FILE="./config/configuration.yaml"

# Keycloak Knowledge secret so that knowledge can successfully invoke
# other services. Not that it is also required because some MCP server side services
# hosted by knowledge-flow invoke themselves.

# -----------------------------------------------------------------------------
# 🟠 KEYCLOAK
# -----------------------------------------------------------------------------

KEYCLOAK_KNOWLEDGE_FLOW_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 🔵 AZURE AUTHENTICATION (for getting OAuth token)
# -----------------------------------------------------------------------------

AZURE_AD_CLIENT_SECRET=""
# Client Secret of your Azure AD Application

# -----------------------------------------------------------------------------
# 🔵 API GATEWAY (APIM) SETTINGS
# -----------------------------------------------------------------------------

AZURE_APIM_SUBSCRIPTION_KEY=""
# Subscription Key required by the APIM Gateway ("TrustNest-Apim-Subscription-Key" header)

# -----------------------------------------------------------------------------
# 🔵 AZURE OPENAI DIRECT SETTINGS (if AZURE_USE_APIM=false)
# -----------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=""
# Azure OpenAI API Key (directly from Azure portal, not APIM key)

# -----------------------------------------------------------------------------
# OPENAI-COMPATIBLE MODELS (Public API or compatible gateway)
# -----------------------------------------------------------------------------

OPENAI_API_KEY=""
# Fallback for each model use without a dedicated key.
KNOWLEDGE_FLOW_CHAT_API_KEY=""
KNOWLEDGE_FLOW_VISION_API_KEY=""
KNOWLEDGE_FLOW_EMBEDDINGS_API_KEY=""
KNOWLEDGE_FLOW_OCR_API_KEY=""

# -----------------------------------------------------------------------------
# 🟡 GOOGLE / VERTEX AUTHENTICATION
# -----------------------------------------------------------------------------

# Local/dev: path to a service-account JSON key file used by ADC.
# On GCP runtime (Workload Identity / metadata), leave empty.
GOOGLE_APPLICATION_CREDENTIALS=""

# -----------------------------------------------------------------------------
# 🟢 Postgres storage configuration
# -----------------------------------------------------------------------------

# Postgres credentials
FRED_POSTGRES_PASSWORD=""
# -----------------------------------------------------------------------------
# 🟢 Opensearch storage configuration
# -----------------------------------------------------------------------------

# Opensearch credentials
OPENSEARCH_PASSWORD=""

# -----------------------------------------------------------------------------
# 🟢 MinIO storage configuration
# -----------------------------------------------------------------------------

# MinIO credentials
MINIO_SECRET_KEY=""

# -----------------------------------------------------------------------------
# 🟢 Prometheus configuration
# -----------------------------------------------------------------------------

# Optional Prometheus basic-auth password
PROMETHEUS_PASSWORD=""

# Optional Prometheus bearer token
PROMETHEUS_BEARER_TOKEN=""

# -----------------------------------------------------------------------------
# 🕸️ ReBAC (OpenFGA)
# -----------------------------------------------------------------------------

# Preshared key used to authenticate with the OpenFGA API
OPENFGA_API_TOKEN=""

# Clickouse credentials
CLICKHOUSE_PASSWORD=""
