{
  "$defs": {
    "AppConfig": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Knowledge Flow Backend",
          "title": "Name"
        },
        "base_url": {
          "default": "/knowledge-flow/v2",
          "title": "Base Url",
          "type": "string"
        },
        "address": {
          "default": "127.0.0.1",
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "title": "Port",
          "type": "integer"
        },
        "log_level": {
          "default": "info",
          "title": "Log Level",
          "type": "string"
        },
        "log_format": {
          "default": "text",
          "enum": [
            "json",
            "text"
          ],
          "title": "Log Format",
          "type": "string"
        },
        "reload": {
          "default": false,
          "title": "Reload",
          "type": "boolean"
        },
        "reload_dir": {
          "default": ".",
          "title": "Reload Dir",
          "type": "string"
        },
        "gcu_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gcu Version"
        }
      },
      "title": "AppConfig",
      "type": "object",
      "additionalProperties": false
    },
    "ArtifactStorageConfig": {
      "additionalProperties": false,
      "description": "S3 connection for generation artifacts, independent of worker settings.",
      "properties": {
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "bucket": {
          "title": "Bucket",
          "type": "string"
        },
        "region": {
          "default": "us-east-1",
          "title": "Region",
          "type": "string"
        },
        "access_key_env": {
          "title": "Access Key Env",
          "type": "string"
        },
        "secret_key_env": {
          "title": "Secret Key Env",
          "type": "string"
        },
        "allow_insecure": {
          "default": false,
          "title": "Allow Insecure",
          "type": "boolean"
        }
      },
      "required": [
        "endpoint",
        "bucket",
        "access_key_env",
        "secret_key_env"
      ],
      "title": "ArtifactStorageConfig",
      "type": "object"
    },
    "DelegationConfig": {
      "additionalProperties": false,
      "description": "`security.delegation` block. Off by default, one switch per direction.\n\nA workload may speak for a person when its verified token is addressed to\n`audience` and lists `caller_role` in the claim `caller_roles_claim` names.",
      "properties": {
        "act_for_people": {
          "default": false,
          "description": "Outgoing: backend calls on behalf of a person present this backend's workload token and name the verified person, run and agent. Enable for agent runtimes and Knowledge Flow calls to the Control Plane.",
          "title": "Act For People",
          "type": "boolean"
        },
        "accept_delegated_calls": {
          "default": false,
          "description": "Incoming: believe the person a calling workload names when that workload's token carries caller_role.",
          "title": "Accept Delegated Calls",
          "type": "boolean"
        },
        "audience": {
          "default": "fred-delegation",
          "maxLength": 256,
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "caller_role": {
          "default": "delegation_caller",
          "maxLength": 256,
          "minLength": 1,
          "title": "Caller Role",
          "type": "string"
        },
        "caller_roles_claim": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to the list of roles in a verified token, one entry per nested claim name. Defaults to resource_access.<audience>.roles, where Keycloak puts the roles of the audience client.",
          "title": "Caller Roles Claim"
        },
        "service_accounts_only": {
          "default": false,
          "description": "Trust only a token Keycloak issued to a client's own service account: its preferred_username is service-account-<client> and it carries the client_id claim (clientId before Keycloak 21.1) that only client-credentials tokens get. Keycloak-specific; a person's token then never delegates, whichever client issued it.",
          "title": "Service Accounts Only",
          "type": "boolean"
        },
        "user_clients": {
          "description": "Clients people sign in through, besides security.user.client_id. A token issued to one never delegates, whatever roles it carries. List the login client where security.user.client_id names this receiver's own audience instead.",
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "User Clients",
          "type": "array"
        }
      },
      "title": "DelegationConfig",
      "type": "object"
    },
    "InferenceCredentialBinding": {
      "additionalProperties": false,
      "description": "A workload's local attestation of one admitted destination, read from its own\nconfiguration: variable names only, never secrets. Every model client (Agent Pod,\nKnowledge Flow) checks the Control Plane's admitted connection against it.",
      "properties": {
        "credential_binding": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Credential Binding",
          "type": "string"
        },
        "api_root": {
          "title": "Api Root",
          "type": "string"
        },
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "client_secret_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Secret Env"
        },
        "gateway_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Key Env"
        }
      },
      "required": [
        "credential_binding",
        "api_root"
      ],
      "title": "InferenceCredentialBinding",
      "type": "object"
    },
    "KpiLogSinkConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "level": {
          "default": "info",
          "title": "Level",
          "type": "string"
        },
        "summary_interval_sec": {
          "default": 0.0,
          "title": "Summary Interval Sec",
          "type": "number"
        },
        "summary_top_n": {
          "default": 0,
          "title": "Summary Top N",
          "type": "integer"
        }
      },
      "title": "KpiLogSinkConfig",
      "type": "object",
      "additionalProperties": false
    },
    "KpiObservabilityConfig": {
      "description": "KPI sink configuration shared across all Fred backends.\n\nDefaults enable Prometheus + OpenSearch (prod-ready out of the box).\nFor local dev, disable both and enable log instead:\n\n    observability:\n      kpi:\n        log:\n          enabled: true\n        prometheus:\n          enabled: false\n        opensearch:\n          enabled: false",
      "properties": {
        "log": {
          "$ref": "#/$defs/KpiLogSinkConfig"
        },
        "prometheus": {
          "$ref": "#/$defs/KpiPrometheusSinkConfig"
        },
        "opensearch": {
          "$ref": "#/$defs/KpiOpenSearchSinkConfig"
        },
        "process_metrics_interval_sec": {
          "default": 10,
          "description": "Emit process/SQL-pool KPIs every N seconds. 0 to disable.",
          "title": "Process Metrics Interval Sec",
          "type": "integer"
        }
      },
      "title": "KpiObservabilityConfig",
      "type": "object",
      "additionalProperties": false
    },
    "KpiOpenSearchSinkConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "index": {
          "default": "kpi-index",
          "title": "Index",
          "type": "string"
        }
      },
      "title": "KpiOpenSearchSinkConfig",
      "type": "object",
      "additionalProperties": false
    },
    "KpiPrometheusSinkConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "port": {
          "default": 9000,
          "title": "Port",
          "type": "integer"
        },
        "address": {
          "default": "127.0.0.1",
          "title": "Address",
          "type": "string"
        }
      },
      "title": "KpiPrometheusSinkConfig",
      "type": "object",
      "additionalProperties": false
    },
    "M2MSecurity": {
      "additionalProperties": false,
      "description": "Configuration for machine-to-machine authentication.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "realm_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Realm Url",
          "type": "string"
        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "provider": {
          "default": "keycloak",
          "enum": [
            "keycloak",
            "oidc"
          ],
          "title": "Provider",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "token_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Url"
        },
        "secret_env_var": {
          "default": "M2M_CLIENT_SECRET",
          "title": "Secret Env Var",
          "type": "string"
        }
      },
      "required": [
        "realm_url",
        "client_id"
      ],
      "title": "M2MSecurity",
      "type": "object"
    },
    "ModelConfiguration": {
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider of the AI model, e.g., openai, ollama, azure.",
          "title": "Provider"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model name, e.g., gpt-4o, llama2.",
          "title": "Name"
        },
        "settings": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Additional provider-specific settings, e.g. Azure endpoint/API version or Vertex AI project/location.",
          "title": "Settings"
        }
      },
      "title": "ModelConfiguration",
      "type": "object",
      "additionalProperties": false
    },
    "ObservabilityConfig": {
      "properties": {
        "kpi": {
          "$ref": "#/$defs/KpiObservabilityConfig"
        }
      },
      "title": "ObservabilityConfig",
      "type": "object",
      "additionalProperties": false
    },
    "OpenSearchStoreConfig": {
      "properties": {
        "host": {
          "description": "OpenSearch host URL",
          "title": "Host",
          "type": "string"
        },
        "username": {
          "description": "Username from env",
          "title": "Username",
          "type": "string"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Password from env",
          "title": "Password"
        },
        "secure": {
          "default": false,
          "description": "Use TLS (https)",
          "title": "Secure",
          "type": "boolean"
        },
        "verify_certs": {
          "default": false,
          "description": "Verify TLS certs",
          "title": "Verify Certs",
          "type": "boolean"
        }
      },
      "required": [
        "host",
        "username"
      ],
      "title": "OpenSearchStoreConfig",
      "type": "object",
      "additionalProperties": false
    },
    "OpenSearchVectorIndexConfig": {
      "properties": {
        "type": {
          "const": "opensearch",
          "title": "Type",
          "type": "string"
        },
        "index": {
          "description": "OpenSearch index name",
          "title": "Index",
          "type": "string"
        },
        "bulk_size": {
          "default": 1000,
          "description": "Number of documents to send in each bulk insert request",
          "title": "Bulk Size",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "index"
      ],
      "title": "OpenSearchVectorIndexConfig",
      "type": "object",
      "additionalProperties": false
    },
    "PgVectorStorageConfig": {
      "description": "PostgreSQL + pgvector backend.\n- Uses shared `storage.postgres` connection settings.\n- Stores vectors in the default pgvector table under a collection name.",
      "properties": {
        "type": {
          "const": "pgvector",
          "title": "Type",
          "type": "string"
        },
        "collection_name": {
          "default": "fred_chunks",
          "description": "Logical collection name",
          "title": "Collection Name",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "PgVectorStorageConfig",
      "type": "object",
      "additionalProperties": false
    },
    "PostgresStoreConfig": {
      "properties": {
        "type": {
          "const": "postgres",
          "default": "postgres",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PostgreSQL host",
          "title": "Host"
        },
        "port": {
          "default": 5432,
          "title": "Port",
          "type": "integer"
        },
        "sqlite_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to the SQLite database file (for local dev/testing).",
          "title": "Sqlite Path"
        },
        "database": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "schema": {
          "anyOf": [
            {
              "pattern": "^[a-z_][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Owning PostgreSQL schema; required for PostgreSQL connections.",
          "title": "Schema"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Password"
        },
        "echo": {
          "default": false,
          "description": "SQLAlchemy echo flag.",
          "title": "Echo",
          "type": "boolean"
        },
        "pool_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional pool size for the engine.",
          "title": "Pool Size"
        },
        "max_overflow": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional max_overflow for SQLAlchemy pool (defaults to SQLAlchemy's 10 if unset).",
          "title": "Max Overflow"
        },
        "pool_timeout": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds to wait for a connection from the pool before timing out.",
          "title": "Pool Timeout"
        },
        "pool_recycle": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recycle connections after this many seconds (prevents stale TCP / server timeouts).",
          "title": "Pool Recycle"
        },
        "pool_pre_ping": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Enable SQLAlchemy pool_pre_ping to evict stale connections.",
          "title": "Pool Pre Ping"
        },
        "connect_args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional connect_args passed to SQLAlchemy.",
          "title": "Connect Args"
        }
      },
      "title": "PostgresStoreConfig",
      "type": "object",
      "additionalProperties": false
    },
    "SecurityConfiguration": {
      "properties": {
        "m2m": {
          "$ref": "#/$defs/M2MSecurity"
        },
        "user": {
          "$ref": "#/$defs/UserSecurity"
        },
        "user_directory": {
          "default": "keycloak",
          "enum": [
            "keycloak",
            "local"
          ],
          "title": "User Directory",
          "type": "string"
        },
        "delegation": {
          "$ref": "#/$defs/DelegationConfig"
        },
        "authorized_origins": {
          "default": [],
          "items": {
            "format": "uri",
            "minLength": 1,
            "type": "string"
          },
          "title": "Authorized Origins",
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "const": "c3",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hardened security profile (RUNTIME-07). 'c3' forces strict JWT issuer/audience validation, forbids no-security/mock-admin, and \u2014 failing startup otherwise. The control-plane issues no signed grant.",
          "title": "Profile"
        }
      },
      "required": [
        "m2m",
        "user"
      ],
      "title": "SecurityConfiguration",
      "type": "object",
      "additionalProperties": false
    },
    "StorageConfig": {
      "properties": {
        "postgres": {
          "$ref": "#/$defs/PostgresStoreConfig"
        },
        "opensearch": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpenSearchStoreConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional OpenSearch store"
        },
        "tabular_store": {
          "$ref": "#/$defs/TabularStoreConfig",
          "description": "Dataset-centric tabular runtime configuration backed by Parquet artifacts in content storage."
        },
        "vector_store": {
          "discriminator": {
            "mapping": {
              "opensearch": "#/$defs/OpenSearchVectorIndexConfig",
              "pgvector": "#/$defs/PgVectorStorageConfig"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OpenSearchVectorIndexConfig"
            },
            {
              "$ref": "#/$defs/PgVectorStorageConfig"
            }
          ],
          "title": "Vector Store"
        }
      },
      "required": [
        "postgres",
        "vector_store"
      ],
      "title": "StorageConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TabularQueryConfig": {
      "description": "Runtime settings for dataset-centric SQL queries.\n\nWhy this exists:\n- Tabular querying now runs on transient Parquet datasets rather than\n  long-lived SQL tables.\n- These values keep query execution bounded and configurable from YAML.\n\nHow to use:\n- Keep the default `duckdb` engine.\n- Tune result limits and backend-internal presigned URL TTL per deployment.\n- Set DuckDB's CA file and server verification for HTTPS Parquet reads when needed.",
      "properties": {
        "engine": {
          "const": "duckdb",
          "default": "duckdb",
          "description": "Embedded query engine used to read Parquet datasets.",
          "title": "Engine",
          "type": "string"
        },
        "access_mode": {
          "const": "presigned_url",
          "default": "presigned_url",
          "description": "Primary object-access method for remote tabular artifacts.",
          "title": "Access Mode",
          "type": "string"
        },
        "internal_presigned_ttl_seconds": {
          "default": 3600,
          "description": "TTL in seconds for backend-internal object-storage URLs used by tabular DuckDB reads.",
          "minimum": 1,
          "title": "Internal Presigned Ttl Seconds",
          "type": "integer"
        },
        "default_max_rows": {
          "default": 200,
          "description": "Default preview row limit applied when callers omit max_rows.",
          "minimum": 1,
          "title": "Default Max Rows",
          "type": "integer"
        },
        "max_rows": {
          "default": 1000,
          "description": "Hard cap applied to query result previews. Bounds the rows returned, not the work done to produce them: use the execution guardrails below for that.",
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "max_concurrent_queries": {
          "default": 2,
          "description": "Maximum DuckDB jobs running at once in this process. Sizes the dedicated thread pool, so it also bounds worst-case DuckDB memory together with duckdb_memory_limit.",
          "minimum": 1,
          "title": "Max Concurrent Queries",
          "type": "integer"
        },
        "max_queued_queries": {
          "default": 4,
          "description": "Extra jobs allowed to wait for a free slot before new requests are rejected with 503. Absorbs bursts without letting the queue grow without bound.",
          "minimum": 0,
          "title": "Max Queued Queries",
          "type": "integer"
        },
        "query_timeout_seconds": {
          "default": 30.0,
          "description": "Wall-clock budget for one DuckDB job before it is aborted and the caller receives 504. Abort is best-effort for work blocked on network I/O.",
          "exclusiveMinimum": 0,
          "title": "Query Timeout Seconds",
          "type": "number"
        },
        "duckdb_threads": {
          "default": 1,
          "description": "Threads DuckDB may use per connection. Set explicitly because DuckDB otherwise auto-detects the host's CPUs and ignores the container's CPU limit.",
          "minimum": 1,
          "title": "Duckdb Threads",
          "type": "integer"
        },
        "duckdb_memory_limit": {
          "default": "256MB",
          "description": "Buffer-manager budget per DuckDB connection, e.g. '256MB'. Validated at startup so a typo fails fast instead of at the first query.",
          "pattern": "(?i)^\\d+(\\.\\d+)?\\s*(B|[KMGT]B|[KMGT]iB)$",
          "title": "Duckdb Memory Limit",
          "type": "string"
        },
        "duckdb_ca_cert_file": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional CA bundle path for DuckDB httpfs HTTPS reads. The file must be readable inside the Knowledge Flow container.",
          "title": "Duckdb Ca Cert File"
        },
        "duckdb_enable_server_cert_verification": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional DuckDB httpfs server certificate verification setting. Omit to retain the installed DuckDB default.",
          "title": "Duckdb Enable Server Cert Verification"
        },
        "max_selected_datasets": {
          "default": 50,
          "description": "Maximum datasets one request may mount or scan. Backstop for searches and for queries whose referenced-relation set is still too large.",
          "minimum": 1,
          "title": "Max Selected Datasets",
          "type": "integer"
        }
      },
      "title": "TabularQueryConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TabularStoreConfig": {
      "description": "Dataset-centric tabular storage settings for the supported tabular runtime.\n\nWhy this exists:\n- CSV ingestion persists one Parquet artifact per document in the shared\n  content store.\n- One dedicated config block keeps object keys and query limits explicit.\n\nHow to use:\n- Configure the block directly under `storage.tabular_store`.\n- `artifacts_prefix` namespaces Parquet datasets under the shared\n  content-store object area.\n- `format` is intentionally fixed to `parquet`.",
      "properties": {
        "artifacts_prefix": {
          "default": "tabular/datasets",
          "description": "Logical prefix for tabular dataset keys within a processing attempt.",
          "title": "Artifacts Prefix",
          "type": "string"
        },
        "format": {
          "const": "parquet",
          "default": "parquet",
          "description": "Physical storage format used for tabular artifacts.",
          "title": "Format",
          "type": "string"
        },
        "compression": {
          "default": "snappy",
          "description": "Parquet compression codec used when persisting tabular artifacts.",
          "title": "Compression",
          "type": "string"
        },
        "pointer_chunks_enabled": {
          "default": false,
          "description": "Emit one synthetic 'dataset pointer' chunk per tabular dataset into the shared vector index, so semantic search can discover a dataset exists and route agents to the SQL/tabular tool (RAG-DATASET-DISCOVERY-RFC.md). Off by default for measured, gradual activation.",
          "title": "Pointer Chunks Enabled",
          "type": "boolean"
        },
        "query": {
          "$ref": "#/$defs/TabularQueryConfig",
          "description": "Runtime limits and access settings for tabular SQL queries."
        }
      },
      "title": "TabularStoreConfig",
      "type": "object",
      "additionalProperties": false
    },
    "TextSplitterConfig": {
      "additionalProperties": false,
      "properties": {
        "chunk_size": {
          "default": 1500,
          "description": "Maximum number of characters per chunk for text splitting.",
          "minimum": 1,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "default": 150,
          "description": "Number of overlapping characters between consecutive chunks.",
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "preserve_tables": {
          "default": true,
          "description": "If true, keep annotated markdown tables intact (do not split by size).",
          "title": "Preserve Tables",
          "type": "boolean"
        }
      },
      "title": "TextSplitterConfig",
      "type": "object"
    },
    "UserClaims": {
      "description": "Claim names used to construct an authenticated person's identity.",
      "properties": {
        "uid": {
          "default": "sub",
          "title": "Uid",
          "type": "string"
        },
        "username": {
          "default": "preferred_username",
          "title": "Username",
          "type": "string"
        },
        "email": {
          "default": "email",
          "title": "Email",
          "type": "string"
        },
        "given_name": {
          "default": "given_name",
          "title": "Given Name",
          "type": "string"
        },
        "family_name": {
          "default": "family_name",
          "title": "Family Name",
          "type": "string"
        }
      },
      "title": "UserClaims",
      "type": "object",
      "additionalProperties": false
    },
    "UserSecurity": {
      "description": "Configuration for user authentication.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "realm_url": {
          "description": "Keycloak realm URL or OIDC issuer URL",
          "format": "uri",
          "minLength": 1,
          "title": "Realm Url",
          "type": "string"
        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "provider": {
          "default": "keycloak",
          "enum": [
            "keycloak",
            "oidc"
          ],
          "title": "Provider",
          "type": "string"
        },
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "jwks_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jwks Url"
        },
        "token_url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Url"
        },
        "roles_claim": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roles Claim"
        },
        "claims": {
          "$ref": "#/$defs/UserClaims"
        }
      },
      "required": [
        "realm_url",
        "client_id"
      ],
      "title": "UserSecurity",
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "properties": {
