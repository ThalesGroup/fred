# -----------------------------------------------------------------------------
# Backend development image (hot-reload enabled)
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/python:3.12

ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG UV_VERSION=0.13.5
ARG HF_OFFLINE_STRICT=0

# Install required system dependencies
RUN apt-get update && \
    apt-get install -y git curl make net-tools && \
    rm -rf /var/lib/apt/lists/*

# Install uv globally
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    chmod +x /usr/local/bin/uv

# Setup user and permissions
RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME} && \
    mkdir -p /opt/python && \
    chown -R ${USER_ID}:${GROUP_ID} /opt/python

# Set environment variables for uv and Python
ENV UV_PROJECT_ENVIRONMENT=/app/venv
ENV PATH="/app/venv/bin:$PATH"
ENV HOME=/home/${USER_NAME}
ENV OPENAI_API_KEY=<MUST_BE_DEFINED>
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DUCKDB_EXTENSION_DIRECTORY=${HOME}/.duckdb/extensions
ENV CACHE_HOME=/home/${USER_NAME}/.cache
ENV XDG_CACHE_HOME=${CACHE_HOME}
ENV RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
ENV RERANKER_MODEL_CACHE=${CACHE_HOME}/huggingface/hub
ENV HF_HOME=${CACHE_HOME}
ENV HF_HUB_CACHE=${RERANKER_MODEL_CACHE}
ENV HUGGINGFACE_HUB_CACHE=${RERANKER_MODEL_CACHE}
ENV SENTENCE_TRANSFORMERS_HOME=${RERANKER_MODEL_CACHE}
ENV TRANSFORMERS_CACHE=${RERANKER_MODEL_CACHE}
ENV TORCH_HOME=${CACHE_HOME}/torch
ENV HF_HUB_OFFLINE=${HF_OFFLINE_STRICT}
ENV TRANSFORMERS_OFFLINE=${HF_OFFLINE_STRICT}
ENV HF_HUB_DISABLE_TELEMETRY=1
RUN mkdir -p ${CACHE_HOME} ${RERANKER_MODEL_CACHE} ${TORCH_HOME} && \
    chown -R ${USER_ID}:${GROUP_ID} ${CACHE_HOME}

# Keep editable dependency paths identical to the repository layout.
WORKDIR /workspace/apps/knowledge-flow-backend
COPY --chown=${USER_ID}:${GROUP_ID} apps/knowledge-flow-backend/Makefile apps/knowledge-flow-backend/pyproject.toml apps/knowledge-flow-backend/uv.lock apps/knowledge-flow-backend/README.md ./
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-pod /workspace/libs/fred-pod
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-core /workspace/libs/fred-core
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-knowledge /workspace/libs/fred-knowledge
COPY --chown=${USER_ID}:${GROUP_ID} scripts /workspace/scripts
COPY --chown=${USER_ID}:${GROUP_ID} apps/knowledge-flow-backend/knowledge_flow_backend ./knowledge_flow_backend
COPY --chown=${USER_ID}:${GROUP_ID} apps/knowledge-flow-backend/config ./config
USER ${USER_NAME}

# Install dependencies with uv
RUN make dev
RUN mkdir -p ${DUCKDB_EXTENSION_DIRECTORY}
RUN python -c "\
import duckdb; \
con = duckdb.connect(database=':memory:'); \
con.execute('INSTALL httpfs'); \
con.execute('LOAD httpfs')"

# Expose Fast API port
EXPOSE 8111

# Run the application
ENV PYTHONPATH=/workspace/apps/knowledge-flow-backend
ENTRYPOINT ["make", "run-local"]
