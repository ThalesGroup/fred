ARG PYTHON_VERSION=3.12.15

# -----------------------------------------------------------------------------
# PYTHON BASE: Ubuntu LTS with CPython from uv's standalone builds, so the
# interpreter version is pinned here rather than following the distribution.
# -----------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM mirror.gcr.io/ubuntu:24.04 AS python-install
ARG PYTHON_VERSION
COPY --from=uv /uv /usr/local/bin/uv
# Behind TLS inspection (e.g. Zscaler), `make docker-build` lends the host's CA
# bundle as the `ca-bundle` secret; without it, uv keeps its own roots.
RUN --mount=type=secret,id=ca-bundle \
    apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    UV_PYTHON_INSTALL_DIR=/opt/python uv python install ${PYTHON_VERSION}

FROM mirror.gcr.io/ubuntu:24.04 AS python-base
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
# The packages python:slim provides. Ubuntu's own `ubuntu` user holds UID/GID
# 1000, which fred-user keeps.
RUN apt-get update && \
    apt-get upgrade -y --no-install-recommends && \
    apt-get install -y --no-install-recommends ca-certificates netbase tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    userdel -r ubuntu
COPY --from=python-install /opt/python /opt/python
# Venvs record /usr/local/bin as their home; ensurepip bootstraps them, so the
# interpreter's own pip is not needed.
RUN ln -s /opt/python/cpython-${PYTHON_VERSION}-*/bin/python3.12 /usr/local/bin/python3 && \
    ln -s python3 /usr/local/bin/python && \
    python3 -m pip uninstall --yes --break-system-packages pip
# Compile the venv's bytecode at build time: the image is read back fresh at
# every container start, so bytecode compiled at import is lost on each
# restart, and compiling the whole venv outlasts the liveness probe.
ENV UV_COMPILE_BYTECODE=1

# -----------------------------------------------------------------------------
# BUILD STAGE
# -----------------------------------------------------------------------------
FROM python-base AS builder
ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000

# Install system deps required for build
RUN apt-get update && \
    apt-get install -y git curl make && \
    rm -rf /var/lib/apt/lists/*

# Create virtualenv manually (outside project for portability)
ENV UV_PROJECT_ENVIRONMENT=/app/venv
ENV PATH="/app/venv/bin:$PATH"
ENV TIKTOKEN_CACHE_DIR=/app/encodings

WORKDIR /workspace/apps/knowledge-flow-backend

# Third-party dependencies only, from the manifests alone: this multi-GB venv,
# and the model downloads made with it below, change only with the lock. The
# local packages are installed last, in the runtime stage.
COPY apps/knowledge-flow-backend/pyproject.toml apps/knowledge-flow-backend/uv.lock* ./
COPY apps/knowledge-flow-backend/Makefile ./
COPY scripts/makefiles /workspace/scripts/makefiles
COPY libs/fred-pod/pyproject.toml /workspace/libs/fred-pod/
COPY libs/fred-core/pyproject.toml /workspace/libs/fred-core/
RUN --mount=type=secret,id=ca-bundle \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    make prod VENV=/app/venv TARGET=/app/target \
    UV_SYNC_ARGS="--no-install-project --no-install-local"

# Prepare local encodings directory
RUN mkdir -p $TIKTOKEN_CACHE_DIR

# Download encodings for offline usage
COPY scripts/download_encodings.py /workspace/scripts/
RUN --mount=type=secret,id=ca-bundle \
    if [ -s /run/secrets/ca-bundle ]; then export REQUESTS_CA_BUNDLE=/run/secrets/ca-bundle; fi && \
    python /workspace/scripts/download_encodings.py https://openaipublic.blob.core.windows.net/encodings/cl100k_base.tiktoken

# -----------------------------------------------------------------------------
# FINAL STAGE: PROD IMAGE
# -----------------------------------------------------------------------------
FROM python-base
ARG USER_NAME=fred-user
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG HF_OFFLINE_STRICT=1
ARG PRODUCTION_FASTAPI_DOCS_ENABLED=false

# System deps (minimal)
RUN apt-get update && \
    apt-get install -y \
    curl \
    pandoc \
    inkscape \
    libgl1 \
    libmagic1t64 \
    ffmpeg \
    libreoffice-writer-nogui \
    libreoffice-calc-nogui \
    libreoffice-impress-nogui \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Create user
RUN groupadd -g ${GROUP_ID} ${USER_NAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m ${USER_NAME} && \
    mkdir -p /home/${USER_NAME}/.fred/knowledge-flow && \
    chown -R ${USER_NAME}: /home/${USER_NAME}

# Copy virtualenv and encodings from build stage
COPY --from=builder --chown=${USER_ID}:${GROUP_ID} /app/venv /app/venv
COPY --from=builder --chown=${USER_ID}:${GROUP_ID} /app/encodings /app/encodings

ENV PATH="/app/venv/bin:$PATH"
ENV HOME=/home/${USER_NAME}
ENV TIKTOKEN_CACHE_DIR=/app/encodings
ENV PADDLE_MODELS_DIR=/app/models
ENV PRODUCTION_FASTAPI_DOCS_ENABLED=${PRODUCTION_FASTAPI_DOCS_ENABLED}
ENV DUCKDB_EXTENSION_DIRECTORY=${HOME}/.duckdb/extensions

# Hugging Face / reranker cache layout
ENV CACHE_HOME=/home/${USER_NAME}/.cache
ENV RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
ENV RERANKER_MODEL_CACHE=${CACHE_HOME}/huggingface/hub
ENV HF_HOME=${CACHE_HOME}
ENV HF_HUB_CACHE=${RERANKER_MODEL_CACHE}
ENV HUGGINGFACE_HUB_CACHE=${RERANKER_MODEL_CACHE}
ENV SENTENCE_TRANSFORMERS_HOME=${RERANKER_MODEL_CACHE}
ENV TRANSFORMERS_CACHE=${RERANKER_MODEL_CACHE}
RUN mkdir -p ${CACHE_HOME} ${RERANKER_MODEL_CACHE} ${DOCLING_ARTIFACTS_PATH} ${PADDLE_MODELS_DIR} && \
    chown -R ${USER_ID}:${GROUP_ID} ${CACHE_HOME} ${DOCLING_ARTIFACTS_PATH} ${PADDLE_MODELS_DIR}

# Warm caches during build (faster startup, offline-friendly runtime)
USER ${USER_NAME}
RUN mkdir -p ${DUCKDB_EXTENSION_DIRECTORY}
RUN python -c "\
import duckdb; \
con = duckdb.connect(database=':memory:'); \
con.execute('INSTALL httpfs'); \
con.execute('LOAD httpfs')"
# The downloads below run as fred-user, hence the readable secret mount.
RUN --mount=type=secret,id=ca-bundle,mode=0444 \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle REQUESTS_CA_BUNDLE=/run/secrets/ca-bundle; fi && \
    python -c "\
from sentence_transformers import CrossEncoder; \
import os; \
CrossEncoder(model_name_or_path=os.environ['RERANKER_MODEL'], cache_folder=os.environ['RERANKER_MODEL_CACHE'])"

# Whisper dictation/transcription model (issue #2406): bake into the HF hub
# cache so faster-whisper resolves it offline at runtime (HF_HUB_OFFLINE=1).
# audio_processor.py reads WHISPER_MODEL_SIZE too, so the baked model and the
# one requested at runtime cannot drift apart.
ENV WHISPER_MODEL_SIZE=base
RUN --mount=type=secret,id=ca-bundle,mode=0444 \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle REQUESTS_CA_BUNDLE=/run/secrets/ca-bundle; fi && \
    python -c "\
from faster_whisper import download_model; \
import os; \
print(download_model(os.environ['WHISPER_MODEL_SIZE']))"

# Runtime offline policy for Hugging Face based dependencies.
ENV HF_HUB_OFFLINE=${HF_OFFLINE_STRICT}
ENV TRANSFORMERS_OFFLINE=${HF_OFFLINE_STRICT}
ENV HF_HUB_DISABLE_TELEMETRY=1

# Set working directory
WORKDIR /app

# Preload PaddleOCR and docling models for offline-friendly runtime, before the
# sources below, so a change there does not download them again.
# HF_HUB_OFFLINE must be unset here — download_models.py fetches docling models from HuggingFace
COPY --chown=${USER_ID}:${GROUP_ID} scripts/download_models.py /workspace/scripts/download_models.py
RUN --mount=type=secret,id=ca-bundle,mode=0444 \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle REQUESTS_CA_BUNDLE=/run/secrets/ca-bundle; fi && \
    HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python /workspace/scripts/download_models.py --models-dir ${PADDLE_MODELS_DIR}

# The local packages, installed in editable mode from their source roots under
# /workspace/..., which the image keeps. Only their small install changes when
# they do: the venv copied above stays cached.
COPY --chown=${USER_ID}:${GROUP_ID} apps/knowledge-flow-backend/pyproject.toml apps/knowledge-flow-backend/uv.lock /workspace/apps/knowledge-flow-backend/
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-pod /workspace/libs/fred-pod
COPY --chown=${USER_ID}:${GROUP_ID} libs/fred-core /workspace/libs/fred-core
COPY --chown=${USER_ID}:${GROUP_ID} scripts /workspace/scripts
# Independent opt-in variants for Chroma storage and PyMuPDF extraction.
# The builder and the default runtime image never install this extra.
ARG INSTALL_CHROMA=false
ARG INSTALL_PYMUPDF=false
RUN --mount=type=secret,id=ca-bundle,mode=0444 \
    cd /workspace/apps/knowledge-flow-backend && \
    if [ -s /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi && \
    set -- && \
    case "$INSTALL_CHROMA" in \
        true) set -- "$@" --extra chroma ;; \
        false) ;; \
        *) echo "INSTALL_CHROMA must be true or false" >&2; exit 1 ;; \
    esac && \
    case "$INSTALL_PYMUPDF" in \
        true) set -- "$@" --extra pymupdf ;; \
        false) ;; \
        *) echo "INSTALL_PYMUPDF must be true or false" >&2; exit 1 ;; \
    esac && \
    UV_PROJECT_ENVIRONMENT=/app/venv SSL_CERT_FILE=${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt} \
    /app/venv/bin/uv sync --locked --no-default-groups --no-cache "$@"

# Runtime uses uv; pip and its vendored libraries are only needed during bootstrap.
RUN /app/venv/bin/python -m pip uninstall --yes pip

COPY --chown=${USER_ID}:${GROUP_ID} apps/knowledge-flow-backend/. /app/

# alembic.ini is a real file only at the repo root; the per-project ones are dev-only
# symlinks kept out of the build context (see .dockerignore), because Kaniko would copy
# them verbatim and land a dangling link here. Ship the real file next to /app/pyproject.toml,
# whose [tool.alembic] script_location resolves to /app/alembic.
COPY --chown=${USER_ID}:${GROUP_ID} alembic.ini /app/alembic.ini

# Set environment
ENV PYTHONPATH=/app

# Expose Fast API port
EXPOSE 8111

# Entrypoint without make
ENTRYPOINT ["uvicorn", "knowledge_flow_backend.main:create_app", "--factory"]
CMD ["--port", "8111", "--host", "0.0.0.0", "--log-level", "info", "--loop", "asyncio"]
