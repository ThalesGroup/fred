# -----------------------------------------------------------------------------
# BUILDER
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/node:22.13.0 AS builder

# Install dependencies
RUN apt-get update && \
    apt-get install -y make curl dnsutils iproute2 && \
    rm -rf /var/lib/apt/lists/*

# Mirror the repository layout so the Makefile's ../../scripts includes resolve.
WORKDIR /workspace/apps/frontend

# Copy project files
COPY apps/frontend/ /workspace/apps/frontend/
COPY scripts/ /workspace/scripts/
ARG DIAG=1
RUN if [ "$DIAG" = "1" ]; then \
      echo "== TIMESTAMP ==" && date -u; \
      echo "== NODE/NPM ==" && node -v && npm -v; \
      echo "== NPM CONFIG ==" && npm config list; \
      echo "== .npmrc (if any) ==" && { [ -f /workspace/apps/frontend/.npmrc ] && sed -n '1,200p' /workspace/apps/frontend/.npmrc || echo "no .npmrc"; }; \
      echo "== REGISTRY ==" && npm config get registry && npm ping || true; \
      echo "== DNS =="/bin/true && cat /etc/resolv.conf && getent hosts registry.npmjs.org || true; \
      echo "== CURL TEST ==" && curl -Iv https://registry.npmjs.org/ || true; \
      echo "== ROUTING ==" && ip route || true; \
      echo "== PROXY/ENV ==" && env | grep -E 'HTTP|PROXY|NO_PROXY' || true; \
    fi

# Build web app.
# Vite/Rollup peaks above Node's ~2 GB default old-space heap on this bundle and OOMs
# ("Ineffective mark-compacts near heap limit"). Raise the ceiling explicitly so the
# production build is deterministic regardless of the builder machine's RAM.
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN make build

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
FROM mirror.gcr.io/nginxinc/nginx-unprivileged:1.31.0-alpine AS runtime

# jq validates the deployment-owned application registration list, and the CA
# bundle lets the gateway verify TLS upstreams, before nginx configuration is rendered.
USER root
RUN apk add --no-cache ca-certificates jq

# Copy web app from builder to nginx html directory
COPY --from=builder --chown=nginx:nginx /workspace/apps/frontend/dist /usr/share/nginx/html
COPY --chown=nginx:nginx --chmod=755 apps/frontend/dockerfiles/docker-entrypoint.sh /usr/local/bin/fred-frontend-entrypoint.sh

# Provide a writable config target so the unprivileged runtime can render
# backend proxy locations from environment variables on container startup.
RUN touch /etc/nginx/conf.d/fred.conf && \
    chown nginx:nginx /etc/nginx/conf.d/fred.conf

# Theme overlay target (see docker-entrypoint.sh): nginx-owned so the entrypoint
# can fill it without a volume; mount an emptyDir here under a read-only root
# filesystem. curl and unzip come from the base image, so a base bump that drops
# them fails the build rather than the pod.
RUN mkdir -p /usr/share/nginx/html/theme && \
    chown nginx:nginx /usr/share/nginx/html/theme && \
    command -v curl && command -v unzip

# Disable default configuration for nginx
RUN mv /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.disabled

USER nginx

# Expose default nginx port
EXPOSE 8080

# Render nginx config with backend upstreams, then execute nginx.
ENTRYPOINT ["/usr/local/bin/fred-frontend-entrypoint.sh"]
