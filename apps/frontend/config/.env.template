# Copy this file to .env and adapt it for the applications running locally.
# The frontend Makefile loads config/.env automatically when it exists.
#
# Applications are registered in Admin > Applications (Control Plane SQL).

# Optional theme ZIP, loaded by Vite as well as the Docker entrypoint.
# Local SeaweedFS uses localhost; Docker uses its internal service hostname.
# FRONTEND_THEME_URL=http://localhost:8333/fred-themes/theme.zip
# FRONTEND_THEME_S3_ACCESS_KEY=your-access-key
# FRONTEND_THEME_S3_SECRET_KEY=your-secret-key
# FRONTEND_THEME_S3_REGION=us-east-1
# FRONTEND_THEME_REQUIRED=false
