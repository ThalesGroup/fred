#!/usr/bin/env python3
"""Build the fred-manager image for the local k3d instance (fred-deployment-factory).

Same contract as fred's deploy/k3d/build: writes $K3D_APP_OUT/images.txt, the
content-tagged reference to copy into the cluster, and $K3D_APP_OUT/images.yaml,
the Helm values selecting it.
"""

import json
import os
import subprocess
from pathlib import Path


def build(app_dir: Path, output: Path) -> None:
    output.mkdir(parents=True, exist_ok=True)
    make = ["make", "--no-print-directory", "-C", str(app_dir)]
    image = subprocess.check_output(
        [*make, "-s", "--eval", "print-image: ; @echo $(IMAGE_FULL)", "print-image"],
        text=True,
    ).strip()
    if not image or len(image.split()) != 1 or ":" not in image.rsplit("/", 1)[-1]:
        raise ValueError("Invalid IMAGE_FULL for fred-manager")
    log = output / "fred-manager.log"
    print(f"Build fred-manager (log: {log})", flush=True)
    with log.open("w") as stream:
        subprocess.run([*make, "docker-build"], stdout=stream, stderr=subprocess.STDOUT, check=True)
    digest = subprocess.check_output(
        ["docker", "image", "inspect", "--format", "{{.Id}}", image], text=True
    ).strip()
    if not digest.startswith("sha256:") or len(digest) != 71:
        raise ValueError("Invalid Docker image ID for fred-manager")
    repository = image.rsplit(":", 1)[0]
    tag = f"k3d-{digest[7:19]}"
    reference = f"{repository}:{tag}"
    subprocess.run(["docker", "tag", image, reference], check=True)
    print(f"Built fred-manager: {reference}", flush=True)
    values = {"applications": {"fred-manager": {"image": {"repository": repository, "tag": tag}}}}
    # Publish only a complete build's outputs; JSON is also valid Helm values YAML.
    for name, content in {
        "images.yaml": json.dumps(values, indent=2) + "\n",
        "images.txt": reference + "\n",
    }.items():
        temporary = output / f"{name}.tmp"
        temporary.write_text(content)
        temporary.replace(output / name)


if __name__ == "__main__":
    build(Path(__file__).resolve().parents[2], Path(os.environ["K3D_APP_OUT"]))
