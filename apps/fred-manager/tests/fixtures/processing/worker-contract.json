      "name": {
        "title": "Name",
        "type": "string"
      },
      "files": {
        "items": {
          "$ref": "#/$defs/FileToProcess"
        },
        "title": "Files",
        "type": "array"
      },
      "max_parallelism": {
        "default": 1,
        "title": "Max Parallelism",
        "type": "integer"
      },
      "logging_context": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Logging Context"
      }
