{
  "workflow": "ProcessPush",
  "schema": {
    "$defs": {
      "FileToProcess": {
        "properties": {
          "source_tag": {
            "title": "Source Tag",
            "type": "string"
          },
          "tags": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Display Name"
          },
          "profile": {
            "$ref": "#/$defs/IngestionProcessingProfile",
            "default": "medium"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Task Id"
          },
          "document_uid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Document Uid"
          },
          "external_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "External Path"
          },
          "size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Size"
          },
          "modified_time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Modified Time"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hash"
          },
          "processed_by": {
            "$ref": "#/$defs/KeycloakUser"
          },
          "logging_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Logging Context"
          },
          "extraction_task_queue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extraction Task Queue"
          },
          "push_metadata_activity_timeout_seconds": {
            "default": 300,
            "title": "Push Metadata Activity Timeout Seconds",
            "type": "integer"
          },
          "pull_metadata_activity_timeout_seconds": {
            "default": 1800,
            "title": "Pull Metadata Activity Timeout Seconds",
            "type": "integer"
          },
          "output_activity_timeout_seconds": {
            "default": 3600,
            "title": "Output Activity Timeout Seconds",
            "type": "integer"
          },
          "input_activity_timeout_seconds": {
            "default": 3600,
            "title": "Input Activity Timeout Seconds",
            "type": "integer"
          },
          "heartbeat_timeout_seconds": {
            "default": 300,
            "title": "Heartbeat Timeout Seconds",
            "type": "integer"
          },
          "retry_initial_interval_seconds": {
            "default": 30,
            "title": "Retry Initial Interval Seconds",
            "type": "integer"
          },
          "retry_backoff_coefficient": {
            "default": 2.0,
            "title": "Retry Backoff Coefficient",
            "type": "number"
          },
          "retry_maximum_interval_seconds": {
            "default": 600,
            "title": "Retry Maximum Interval Seconds",
            "type": "integer"
          },
          "retry_maximum_attempts": {
            "default": 6,
            "title": "Retry Maximum Attempts",
            "type": "integer"
          },
          "retry_non_retryable_error_types": {
            "items": {
              "type": "string"
            },
            "title": "Retry Non Retryable Error Types",
            "type": "array"
          }
        },
        "required": [
          "source_tag",
          "processed_by"
        ],
        "title": "FileToProcess",
        "type": "object"
      },
      "IngestionProcessingProfile": {
        "enum": [
          "fast",
          "medium",
          "rich"
        ],
        "title": "IngestionProcessingProfile",
        "type": "string"
      },
      "KeycloakUser": {
        "description": "Represents an authenticated Keycloak user.",
        "properties": {
          "uid": {
            "title": "Uid",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Last Name"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The token's authorized party (`azp`, or `client_id` when `azp` is absent). Set for a client-credentials identity, so a caller can be checked against one exact client rather than a broad service role.",
            "title": "Client Id"
          },
          "token_issuer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Token Issuer"
          },
          "token_audiences": {
            "items": {
              "type": "string"
            },
            "title": "Token Audiences",
            "type": "array",
            "uniqueItems": true
          },
          "token_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Token Type"
          },
          "caller_roles": {
            "items": {
              "type": "string"
            },
            "title": "Caller Roles",
            "type": "array",
            "uniqueItems": true
          },
          "service_account": {
            "default": false,
            "title": "Service Account",
            "type": "boolean"
          },
          "admission_claims": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Admission Claims",
            "type": "object"
          },
          "admission_invalid_claims": {
            "items": {
              "type": "string"
            },
            "title": "Admission Invalid Claims",
            "type": "array",
            "uniqueItems": true
          },
          "admission_issued_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Admission Issued At"
          },
          "admission_expires_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Admission Expires At"
          }
        },
        "required": [
          "uid",
          "username",
          "roles"
        ],
        "title": "KeycloakUser",
        "type": "object"
      }
    },
    "properties": {
      "workflow_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
